---
import Header from '../components/SiteHeader.astro';
import Footer from '../components/SiteFooter.astro';
import '../app.css';
const {
  title,
  description = '',
  showAnnouncement = true,
  socialType = 'website',
  socialCard = 'summary',
  socialImage = '/images/openstack-social.jpg',
  canonicalUrl = new URL(Astro.url.pathname, 'https://www.openstack.org').href,
} = Astro.props;
const comparison = new URL(Astro.url.pathname + Astro.url.search, 'https://beta.openstack.org');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(socialImage, Astro.url.origin).href} />
    <meta property="og:type" content={socialType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="OpenStack" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={socialCard} />
    <slot name="head" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <aside class="comparison-bar" aria-label="Framework comparison">
      Astro review · <a href="/comparison/">Demo guide</a> ·{' '}
      <a href={new URL(Astro.url.pathname + Astro.url.search, 'https://www.openstack.org').href}>Compare production ↗</a> ·{' '}
      <a href={comparison.href}>SvelteKit ↗</a>
    </aside>
    <Header showAnnouncement={showAnnouncement} />
    <slot />
    <Footer />
    <script>
      import '../lib/image-fallback';
    </script>
  </body>
</html>
<style>
  .comparison-bar {
    background: #243746;
    color: white;
    text-align: center;
    font-size: 12px;
    padding: 8px 16px;
  }
  .comparison-bar a {
    color: white;
    text-decoration: underline;
  }
</style>
