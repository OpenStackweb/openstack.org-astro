---
import { env } from 'cloudflare:workers';
import { pageRobots } from '../lib/indexing.mjs';
import Header from '../components/SiteHeader.astro';
import StaticFooter from '../components/SiteFooter.astro';
import Footer from '../components/tina/FooterEditor.astro';
import '../app.css';
import { canonicalFor } from '../lib/seo.mjs';
const {
  title,
  description = '',
  showAnnouncement = true,
  footerEditorPrimary = false,
  navigationEditorPrimary = false,
  socialType = 'website',
  socialCard = 'summary',
  socialImage = '/images/social/openstack.png',
  socialImageAlt,
  locale = 'en_US',
  canonicalUrl = canonicalFor(Astro.url.pathname),
} = Astro.props;
const defaultSocialImage = socialImage === '/images/social/openstack.png';
const imageAlt = socialImageAlt || (defaultSocialImage ? 'OpenStack logo and wordmark' : undefined);
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  ...(description ? { description } : {}),
  inLanguage: locale.replace('_', '-'),
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://www.openstack.org/#website',
    url: 'https://www.openstack.org/',
    name: 'OpenStack',
  },
};
---

<!doctype html>
<html lang={locale.replace('_', '-')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={pageRobots(Astro.url, env)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(socialImage, Astro.url.origin).href} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {defaultSocialImage && (
      <>
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:type" content={socialType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="OpenStack" />
    <meta property="og:locale" content={locale} />
    <meta name="twitter:card" content={defaultSocialImage ? 'summary_large_image' : socialCard} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(pageSchema).replaceAll('<', '\\u003c')}
    ></script>
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(socialImage, Astro.url.origin).href} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <slot name="head" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <Header
      showAnnouncement={showAnnouncement}
      navigationEditorPrimary={navigationEditorPrimary}
      editNavigation={!footerEditorPrimary}
    />
    <slot />
    {navigationEditorPrimary ? <StaticFooter /> : <Footer primary={footerEditorPrimary} />}
    <script>
      import '../lib/image-fallback';
    </script>
  </body>
</html>
