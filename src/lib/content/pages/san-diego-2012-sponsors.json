  "body": "<div class=\"sponsor-logos\">\n<p> </p>\n<hr /><h2>Headline Sponsors</h2>\n<p><a href=\"http://www.hpcloud.com/\" aria-label=\"HP Cloud website\"><img src=\"/assets/sponsors/san-diego/hp-sponsor-logo.jpg\" width=\"90\" height=\"92\" /></a> <a href=\"http://nebula.com/\" aria-label=\"Nebula website\"><img src=\"/themes/openstack/images/conferences/nebula-sponsor-logo.jpg\" width=\"182\" height=\"68\" /></a> <a href=\"http://cloud.ubuntu.com/\" aria-label=\"Ubuntu Cloud website\"><img src=\"/themes/openstack/images/conferences/ubuntu-sponsor-logo.png\" width=\"182\" height=\"66\" /></a></p>\n<p> </p>\n<hr /><h2>Premier Sponsors</h2>\n<p><a href=\"https://www.dell.com/OpenStack\"><img src=\"/assets/sponsors/san-diego/dell.jpg\" width=\"147\" height=\"117\" alt=\"Dell\" /></a><a aria-label=\"intel.com website\" href=\"http://intel.com/opensource\"><img src=\"/assets/sponsors/san-diego/intel.jpg\" width=\"128\" height=\"117\" alt=\"\" /></a><a aria-label=\"vmware.com website\" href=\"http://www.vmware.com/\"><img src=\"/assets/sponsors/san-diego/vmware.jpg\" width=\"236\" height=\"117\" /></a><a aria-label=\"redhat.com website\" href=\"http://www.redhat.com/\"><img src=\"/assets/sponsors/san-diego/redhat.jpg\" width=\"191\" height=\"117\" alt=\"\" /></a><a aria-label=\"cisco.com website\" href=\"http://www.cisco.com/go/one\"><img src=\"/assets/sponsors/san-diego/cisco.jpg\" width=\"128\" height=\"117\" alt=\"\" /></a><a aria-label=\"ibm.com website\" href=\"http://www.ibm.com/\"><img src=\"/assets/sponsors/san-diego/ibm.jpg\" width=\"156\" height=\"117\" alt=\"\" /></a></p>\n<p> </p>\n<hr /><h2>Event Sponsors</h2>\n<p><a aria-label=\"dreamhost.com website\" href=\"http://dreamhost.com/\"><img src=\"/assets/sponsors/san-diego/dreamhost.jpg\" width=\"159\" height=\"117\" alt=\"\" /></a><a aria-label=\"mirantis.com website\" href=\"http://www.mirantis.com/\"><img src=\"/assets/sponsors/san-diego/mirantis.jpg\" width=\"147\" height=\"117\" alt=\"\" /></a><a aria-label=\"cloudscaling.com website\" href=\"http://cloudscaling.com/\"><img src=\"/assets/sponsors/san-diego/cloudscaling.jpg\" width=\"195\" height=\"117\" alt=\"\" /></a><a aria-label=\"brocade.com website\" href=\"http://www.brocade.com/\"><img src=\"/assets/sponsors/san-diego/brocade.jpg\" width=\"163\" height=\"117\" alt=\"\" /></a><a aria-label=\"morphlabs.com website\" href=\"http://www.morphlabs.com/\"><img src=\"/assets/sponsors/san-diego/morph.jpg\" width=\"236\" height=\"117\" alt=\"\" /></a><a aria-label=\"netapp.com website\" href=\"http://www.netapp.com/\"><img src=\"/assets/sponsors/san-diego/netapp.jpg\" width=\"75\" height=\"117\" alt=\"\" /></a><a aria-label=\"mellanox.com website\" href=\"http://www.mellanox.com/\"><img src=\"/assets/sponsors/san-diego/mellanox.jpg\" width=\"111\" height=\"117\" alt=\"\" /></a><a aria-label=\"twcloud.org.tw website\" href=\"http://www.twcloud.org.tw/\"><img src=\"/assets/sponsors/san-diego/itri.jpg\" width=\"245\" height=\"117\" /></a><a aria-label=\"opscode.com website\" href=\"http://www.opscode.com/\"><img src=\"/assets/sponsors/san-diego/opscode.jpg\" width=\"147\" height=\"117\" alt=\"\" /></a><a aria-label=\"suse.com website\" href=\"https://www.suse.com/\"><img src=\"/assets/sponsors/san-diego/suse.jpg\" width=\"147\" height=\"117\" alt=\"\" /></a></p>\n<p> </p>\n<hr /><h2>Startup Sponsors</h2>\n<p><a aria-label=\"zadarastorage.com website\" href=\"http://zadarastorage.com/\"><img src=\"/assets/sponsors/san-diego/zadara.jpg\" width=\"209\" height=\"117\" alt=\"\" /></a> <a aria-label=\"pistoncloud.com website\" href=\"http://www.pistoncloud.com/\"><img src=\"/assets/sponsors/san-diego/piston.jpg\" width=\"154\" height=\"117\" /></a> <a aria-label=\"inktank.com website\" href=\"http://www.inktank.com/\"><img src=\"/assets/sponsors/san-diego/inktank.jpg\" width=\"154\" height=\"117\" alt=\"\" /></a> <a aria-label=\"solidfire.com website\" href=\"http://solidfire.com/\"><img src=\"/assets/sponsors/san-diego/solidfire.jpg\" width=\"183\" height=\"117\" alt=\"\" /></a> <a aria-label=\"midokura.com website\" href=\"http://www.midokura.com/\"><img src=\"/assets/sponsors/san-diego/midokura.jpg\" height=\"117\" alt=\"\" /></a> <a aria-label=\"swiftstack.com website\" href=\"http://swiftstack.com/\"><img src=\"/assets/sponsors/san-diego/swiftstack.jpg\" width=\"215\" height=\"117\" alt=\"\" /></a> <a aria-label=\"vizvid.com website\" href=\"http://vizvid.com/accounts/login/?next=/\"><img src=\"/assets/sponsors/san-diego/vizvid.jpg\" width=\"183\" height=\"117\" alt=\"\" /></a><a aria-label=\"metacloud.com website\" href=\"http://www.metacloud.com/\"><img src=\"/assets/sponsors/san-diego/metacloud.jpg\" width=\"173\" height=\"117\" alt=\"\" /></a><a aria-label=\"cloudbasesolutions.com website\" href=\"http://www.cloudbasesolutions.com/\"><img src=\"/assets/sponsors/san-diego/cloudbase.jpg\" width=\"179\" height=\"117\" alt=\"\" /></a></p>\n</div>",
