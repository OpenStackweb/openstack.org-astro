  "body": "<div class=\"sponsor-logos\">\n<h2><br />Headline Sponsors</h2>\n<p><a href=\"http://hpcloud.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/premiere/hp.jpg\" width=\"81\" height=\"77\" alt=\"\" /></a><a href=\"http://www.nebula.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/premiere/nebula.jpg\" width=\"176\" height=\"77\" alt=\"\" /></a><a href=\"http://www.ubuntu.com/cloud\"><img class=\"leftAlone\" src=\"/assets/sponsors/premiere/ubuntu.jpg\" width=\"130\" height=\"77\" alt=\"\" /></a></p>\n<p> </p>\n<h3>\n<hr /></h3>\n<h2>Premiere Sponsors</h2>\n<p><a href=\"http://www.cisco.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/headline/cisco.jpg\" width=\"112\" height=\"77\" alt=\"\" /></a><a href=\"http://content.dell.com/us/en/enterprise/by-need-it-productivity-data-center-change-response-openstack-cloud\"><img class=\"leftAlone\" src=\"/assets/sponsors/headline/dell.jpg\" width=\"102\" height=\"77\" alt=\"\" /></a><a href=\"http://www.ibm.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/headline/ibm.jpg\" width=\"112\" height=\"77\" alt=\"\" /></a><a href=\"http://software.intel.com/sites/oss/projects/openstack.php#page=resources\"><img class=\"leftAlone\" src=\"/assets/sponsors/headline/intel.jpg\" width=\"87\" height=\"77\" alt=\"\" /></a></p>\n<p> </p>\n<h3>\n<hr /></h3>\n<h2>Event Sponsors</h2>\n<p><a href=\"http://dreamhost.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/event/dreamhost.jpg\" width=\"169\" height=\"77\" alt=\"\" /></a> <a href=\"http://www.itri.org.tw/\"><img class=\"leftAlone\" src=\"/assets/sponsors/event/itri.jpg\" width=\"166\" height=\"77\" alt=\"\" /></a> <a href=\"http://www.morphlabs.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/event/morphlabs.jpg\" width=\"182\" height=\"77\" alt=\"\" /></a> <a href=\"http://www.netapp.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/event/netapp.jpg\" width=\"63\" height=\"77\" alt=\"\" /></a> <a href=\"http://nexenta.com/corp/\"><img class=\"leftAlone\" src=\"/assets/sponsors/event/nexenta.jpg\" width=\"190\" height=\"77\" alt=\"\" /></a> <a href=\"http://www.sds.samsung.com/\"><img class=\"left\" src=\"/assets/sponsors/event/samsung.jpg\" width=\"243\" height=\"56\" alt=\"\" /></a> <a href=\"http://yahoo.com/\"><img class=\"left\" src=\"/assets/sponsors/event/yahoo.jpg\" width=\"190\" height=\"77\" alt=\"\" /></a></p>\n<p> </p>\n<hr /><h2>Startup Sponsors</h2>\n<p><a href=\"http://www.pistoncloud.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/pistoncc.jpg\" width=\"140\" height=\"77\" alt=\"\" /></a><a href=\"http://ceph.newdream.net/openstack/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/ceph.jpg\" width=\"140\" height=\"77\" alt=\"\" /></a><a href=\"http://www.cloudscaling.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/cloudscaling.jpg\" width=\"169\" height=\"77\" alt=\"\" /></a><a href=\"http://www.elasticbox.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/elasticbox.jpg\" width=\"175\" height=\"77\" alt=\"\" /></a><a href=\"http://mirantis.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/mirantis.jpg\" width=\"103\" height=\"77\" alt=\"\" /></a><a href=\"http://nicira.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/nicira.jpg\" width=\"96\" height=\"77\" alt=\"\" /></a><a href=\"http://solidfire.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/solidfire.jpg\" width=\"140\" height=\"77\" alt=\"\" /></a><a href=\"http://www.stackops.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/stackops.jpg\" width=\"158\" height=\"77\" alt=\"\" /></a><a href=\"http://swiftstack.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/startup/swiftstack.jpg\" width=\"187\" height=\"77\" alt=\"\" /></a></p>\n<p> </p>\n<hr /><h2>Event Organizer</h2>\n<p><a href=\"http://www.rackspace.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/organizers/rackspace.jpg\" width=\"157\" height=\"77\" alt=\"\" /></a></p>\n<p> </p>\n<hr /><h2>Remote Participation</h2>\n<p><a href=\"http://zareason.com/\"><img class=\"leftAlone\" src=\"/assets/sponsors/organizers/zareason.jpg\" width=\"159\" height=\"77\" alt=\"\" />  </a><a href=\"http://www.cisco.com/\"><img src=\"/assets/sponsors/headline/cisco.jpg\" width=\"112\" height=\"77\" alt=\"\" /></a></p>\n</div>",
