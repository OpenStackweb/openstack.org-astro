  "body": "<div class=\"archive-landing\">\n\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-sm-8 col-sm-push-2 guide-header\">\n<h2>Local's Guide To Barcelona</h2>\n<p>\nBefore you travel, make sure to <a href=\"https://www.openstack.org/summit/barcelona-2016/travel/travel-tips/\">check out these pro tips</a>!\n</p>\n</div>\n</div>\n</div>\n<div class=\"guide-nav\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"guide-icons-wrapper\">\n<a class=\"guide-icons\" href=\"#food\">\n<i class=\"fa fa-cutlery\"></i>\nFood\n</a>\n<a class=\"guide-icons\" href=\"#drinks\">\n<i class=\"fa fa-beer\"></i>\nDrinks\n</a>\n<a class=\"guide-icons\" href=\"#active\">\n<i class=\"fa fa-institution\"></i>\nSights, Activities &amp; Culture\n</a>\n<a class=\"guide-icons\" href=\"#family\">\n<i class=\"fa fa-map-signs\"></i>\nFamily Friendly\n</a>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container\">\n\n<div class=\"row\">\n<h5 class=\"section-title guide\" id=\"food\">Brunch</h5>\n</div>\n<div class=\"row\">\n<div class=\"featured-guide-row\">\n<div class=\"featured\">\n<div class=\"image-wrapper\"><img alt=\"\" loading=\"lazy\" src=\"/assets/summit-landing-archive/a6940976ff1b/cornelia.jpg\" />\n</div>\n<div class=\"featured-content\">\n<h5>Cornelia and Co</h5>\n<div class=\"address\">\nCarrer de València, 225\n</div>\n<p>\nKnown as \"The Daily Picnic Store,\" you'll find a charcutere, wine shop, a butchers shop, and a bakery all in one place.\n</p>\n<p>\n<a class=\"featured-site\" href=\"http://www.corneliaandco.com/\" target=\"_blank\">Website</a>\n<a class=\"featured-site\" href=\"https://goo.gl/maps/ZZ2LgKvJqoH2\" target=\"_blank\">Map</a>\n</p>\n</div>\n</div>\n<div class=\"featured\">\n<div class=\"image-wrapper\"><img alt=\"\" loading=\"lazy\" src=\"/assets/summit-landing-archive/1d12f32f7dc0/emma.jpg\" />\n</div>\n<div class=\"featured-content\">\n<h5>Café Emma</h5>\n<div class=\"address\">\nCarrer Pau Clarís, 142\n</div>\n<p>\nEnjoy unique cuisine in an original setting in the heart of Barcelona.\n</p>\n<p>\n<a class=\"featured-site\" href=\"http://www.cafe-emma.com/\" target=\"_blank\">Website</a>\n<a class=\"featured-site\" href=\"https://goo.gl/maps/Wj3HDTBtfwn\" target=\"_blank\">Map</a>\n</p>\n</div>\n</div>\n<div class=\"featured\">\n<div class=\"image-wrapper\"><img alt=\"\" loading=\"lazy\" src=\"/assets/summit-landing-archive/ead9bb589b67/muns.jpg\" />\n</div>\n<div class=\"featured-content\">\n<h5>Muns</h5>\n<div class=\"address\">\n-171, Carrer de Sancho de Ávila, 167,<br />08018 Barcelona, Spain\n</div>\n<p>\nExperience the best handmade empanadas in Barcelona.\n</p>\n<p>\n<a class=\"featured-site\" href=\"http://www.muns.cat/\" target=\"_blank\">Website</a>\n<a class=\"featured-site\" href=\"https://goo.gl/maps/hAfidcn8xa62\" target=\"_blank\">Map</a>\n</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nCaravelle\n</div>\n<div class=\"col-sm-4\">\nCarrer del Pintor Fortuny, 31, 08001 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.caravelle.es/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/zeZxEtm18yQ2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nCan Dendê\n</div>\n<div class=\"col-sm-4\">\nCarrer de la Ciutat de Granada, 44, 08005 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.candende.com/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/d6GMX5bfaVQ2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nRepublic Cafe\n</div>\n<div class=\"col-sm-4\">\nRambla del Poblenou, 22, 08005 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"https://www.yelp.com/biz/rep%C3%BAblic-caf%C3%A8-barcelona-2\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/QeAk5dyucUv\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nBrunch &amp; Cake\n</div>\n<div class=\"col-sm-4\">\n19, Carrer Enric Granados, 19, 08007 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.cupcakesbarcelona.com/shops-brunchcake/?lang=en\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/D1NkEqJ2gxq\" target=\"_blank\">Map</a>\n</div>\n</div>\n\n<div class=\"row\">\n<h5 class=\"section-title guide\">Lunch Or Dinner</h5>\n</div>\n<div class=\"row\">\n<div class=\"featured-guide-row\">\n<div class=\"featured\">\n<div class=\"image-wrapper\"><img alt=\"\" loading=\"lazy\" src=\"/assets/summit-landing-archive/2c0e952f92c6/moments.jpg\" />\n</div>\n<div class=\"featured-content\">\n<h5>Moments</h5>\n<div class=\"address\">\nHotel Mandarin: Passeig de Gràcia, 38-40\n</div>\n<p>\nMoments has won seven Michelin Stars and is managed by chef Carme Ruscalleda, one of the most famous chefs in the country.\n</p>\n<p>\n<a class=\"featured-site\" href=\"http://www.mandarinoriental.com/barcelona/fine-dining/moments/\" target=\"_blank\">Website</a>\n<a class=\"featured-site\" href=\"https://goo.gl/maps/L4tYp5Vbpeq\" target=\"_blank\">Map</a>\n</p>\n</div>\n</div>\n<div class=\"featured\">\n<div class=\"image-wrapper\"><img alt=\"\" loading=\"lazy\" src=\"/assets/summit-landing-archive/035aabf6e112/hojasanta.jpg\" />\n</div>\n<div class=\"featured-content\">\n<h5>Hoja Santa</h5>\n<div class=\"address\">\nAvinguda Mistral, nº 54-56\n</div>\n<p>\nHoja Santa offers the flavours and traditions of Mexico with a twist and holds the Salsa de Chiles 2015 award for best foreign cuisine restaurant.\n</p>\n<p>\n<a class=\"featured-site\" href=\"http://www.hojasanta.es/\" target=\"_blank\">Website</a>\n<a class=\"featured-site\" href=\"https://goo.gl/maps/9cuZdxSLKtn\" target=\"_blank\">Map</a>\n</p>\n</div>\n</div>\n<div class=\"featured\">\n<div class=\"image-wrapper\"><img alt=\"\" loading=\"lazy\" src=\"/assets/summit-landing-archive/2a38ec7ad502/pudding.jpg\" />\n</div>\n<div class=\"featured-content\">\n<h5>Pudding</h5>\n<div class=\"address\">\nCarrer de Pau Claris, 90, 08010 Barcelona, Spain\n</div>\n<p>\nGo for its playful and imaginative décor, stay for its dessert! Also a great place for kids!\n</p>\n<p>\n<a class=\"featured-site\" href=\"http://www.puddingbarcelona.com/\" target=\"_blank\">Website</a>\n<a class=\"featured-site\" href=\"https://goo.gl/maps/71EFwHniPAT2\" target=\"_blank\">Map</a>\n</p>\n</div>\n</div>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nRestaurant Martinez\n</div>\n<div class=\"col-sm-4\">\nCarretera de Miramar, 38\n</div>\n<div class=\"col-sm-4\">\n<a href=\"https://www.yelp.com/biz/martinez-barcelona\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/RjGwz7VDZpv\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nÀbac\n</div>\n<div class=\"col-sm-4\">\nAvinguda del Tibidabo, 1\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.abacbarcelona.com/en\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/W9KTvRpH9452\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nDos Cielos\n</div>\n<div class=\"col-sm-4\">\nHotel Meliá: Carrer de Pere IV, 286, 08005 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.melia.com/es/hoteles/espana/barcelona/melia-barcelona-sky/dos-cielos.html\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/Q8pXWCNHSrF2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nBistreau by Ángel León\n</div>\n<div class=\"col-sm-4\">\nHotel Mandarin: Passeig de Gràcia, 38-40\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.mandarinoriental.es/barcelona/fine-dining/bistreau/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/fiojKncz4zx\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nDos Palillos\n</div>\n<div class=\"col-sm-4\">\nCarrer d´Elisabets, 9\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.dospalillos.com/home.php?rest=1&amp;lang=en\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/nrDLS2vGrSF2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nShunka\n</div>\n<div class=\"col-sm-4\">\nCarrer Sagristans, 5\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.koyshunka.com/KoyShunka/home.html\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/CxFAhYJ3UeK2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nJaime Beriestain\n</div>\n<div class=\"col-sm-4\">\nCarrer Pau Clarís, 167\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://jaime-beriestain.com/CONCEPTSTORE/01restaurante.html\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/2nbSHby5UiQ2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nGallito\n</div>\n<div class=\"col-sm-4\">\nPasseig del Mare Nostrum, 19-21\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.encompaniadelobos.com/gallito/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/WG9XVRGkYYR2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nEl Nacional\n</div>\n<div class=\"col-sm-4\">\nPasseig de Gràcia, 24\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.elnacionalbcn.com/ca/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/tCxgHXzpxjM2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nDisfrutar\n</div>\n<div class=\"col-sm-4\">\nCarrer Villarroel, 163\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://ca.disfrutarbarcelona.com/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/4xzJjqRkzzw\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nXiringuito Escribà\n</div>\n<div class=\"col-sm-4\">\nAvda. Litoral, 62\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.xiringuitoescriba.com/en/index.html#guingueta\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/oj9fKe6unUu\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nPez Vela\n</div>\n<div class=\"col-sm-4\">\nPaseo Mare Nostrum, 19-21\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://grupotragaluz.com/en/restaurante/pez-vela/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/mwCP5H3U8ox\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nBarceloneta\n</div>\n<div class=\"col-sm-4\">\nCarrer de l´Escar, 22\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.restaurantbarceloneta.com/home/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/6D49mfCMNXv\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nArume\n</div>\n<div class=\"col-sm-4\">\nCarrer Botella, 11-13, 08001 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://arumerestaurant.com/eng/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/7RQLZi33dCy\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nCera 23\n</div>\n<div class=\"col-sm-4\">\nCarrer de la Cera, 23 (Metro L2 -Sant Antoni) Barcelona 08001\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.cera23.com/en/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/hiPgxmgm1472\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nCan Recasens\n</div>\n<div class=\"col-sm-4\">\nRambla del Poblenou, 102, 08005 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.canrecasens.com/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/hCFQ5SDeQ4S2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nEls Pescadors\n</div>\n<div class=\"col-sm-4\">\nPlaça de Prim, 1, 08005 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"http://www.elspescadors.com/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/mvzdAsfRRYL2\" target=\"_blank\">Map</a>\n</div>\n</div>\n\n<div class=\"row\">\n<h5 class=\"section-title guide\">Tapas</h5>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nQuimet &amp; Quimet\n</div>\n<div class=\"col-sm-4\">\nCarrer del Poeta Cabanyes, 25, 08004 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"https://www.facebook.com/quimetiquimet/\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/4zYjKWZ3YCt\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nLa Cova Fumada\n</div>\n<div class=\"col-sm-4\">\nCarrer del Baluart, 56, 08003 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"https://www.yelp.com/biz/la-cova-fumada-barcelona\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/gfhBd4wtTj72\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=\"col-sm-4 guide-name\">\nCervecería Catalana\n</div>\n<div class=\"col-sm-4\">\nCarrer de Mallorca, 236, 08008 Barcelona, Spain\n</div>\n<div class=\"col-sm-4\">\n<a href=\"https://www.yelp.com/biz/cervecer%C3%ADa-catalana-barcelona-2\" target=\"_blank\">Website</a>|\n<a href=\"https://goo.gl/maps/A8YehYzc7ES2\" target=\"_blank\">Map</a>\n</div>\n</div>\n<div class=\"row guide-listing\">\n<div class=