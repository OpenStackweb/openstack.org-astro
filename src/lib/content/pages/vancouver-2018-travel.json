  "body": "<div class=\"white hotels-row\" id=\"hotels\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-12\">\n<h2 class=\"section-title\">Recommended Hotels</h2>\n<p>\n<i class=\"fa fa-hotel fa-4x\"></i>\n</p>\n</div>\n</div>\n<div class=\"row\">\n<div class=\"col-lg-4\">\n<h3>Four Seasons</h3>\n<p>\n791 W Georgia St, Vancouver, BC, CA\n</p>\n<p class=\"summit-location-message\">\n55% OFF THROUGH APRIL 25\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-346\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://www.fourseasons.com/vancouver/landing_pages/events/OpenStack_Summit/\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n<div class=\"col-lg-4\">\n<h3>Pan Pacific </h3>\n<p>\n300 - 999 Canada Place, Vancouver, BC, CA\n</p>\n<p class=\"summit-location-message\">\n45% OFF THROUGH April 25\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-343\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://aws.passkey.com/go/2018OpenStackSummit\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n<div class=\"col-lg-4\">\n<h3>Fairmont Hotel Vancouver</h3>\n<p>\n900 W Georgia St, Vancouver, BC, CA\n</p>\n<p class=\"summit-location-message\">\n44% OFF THROUGH May 4\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-342\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://resweb.passkey.com/go/openstack2018\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n</div>\n<div class=\"row\">\n<div class=\"col-lg-4\">\n<h3>Fairmont Pacific Rim</h3>\n<p>\n1038 Canada Pl, Vancouver, BC, CA\n</p>\n<p class=\"summit-location-message\">\n40% OFF THROUGH May 4\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-340\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://resweb.passkey.com/go/openstack2018vpr\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n<div class=\"col-lg-4\">\n<h3>Fairmont Waterfront Hotel</h3>\n<p>\n900 Canada Pl, Vancouver, BC, CA\n</p>\n<p class=\"summit-location-message\">\n43% OFF THROUGH May 4\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-341\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://resweb.passkey.com/go/openstacksummit2018\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n<div class=\"col-lg-4\">\n<h3>Vancouver Marriott Pinnacle Downtown</h3>\n<p>\n1128 W Hastings St, Vancouver, BC, CA\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-339\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://aws.passkey.com/e/49171307\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n</div>\n<div class=\"row\">\n<div class=\"col-lg-4\">\n<h3>Hyatt Regency</h3>\n<p>\n655 Burrard St, Vancouver, BC, CA\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-345\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://aws.passkey.com/go/2018openstack\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n<div class=\"col-lg-4\">\n<h3>Pinnacle Hotel Harbourfront</h3>\n<p>\n1133 W Hastings St, Vancouver, BC, CA\n</p>\n<p>\n<a class=\"marker-link\" href=\"#location-344\"><i class=\"fa fa-map-marker\"></i>Map</a>\n<a href=\"https://aws.passkey.com/event/49495336/owner/2075/home\" target=\"_blank\"><i class=\"fa fa-home\"></i>\nBook a Room</a>\n</p>\n</div>\n</div>\n</div>\n</div><div id=\"venue\">\n<div class=\"venue-row tokyo\"><img alt=\"\" src=\"/assets/summit-travel-archive/summits/locations/5403631349-6062029d45-o.jpg\" />\n<div class=\"container\">\n<h2>The Venue</h2>\n<p>\n<strong>Vancouver Convention Centre West</strong>\n1055 Canada Pl<br />\nVancouver , BC V6C 0C3\n</p>\n</div>\n<a aria-label=\"Photo credit\" class=\"photo-credit\" href=\"https://flic.kr/p/8rYHEd\" target=\"_blank\">\n<i class=\"fa fa-info-circle\"></i>\n</a>\n</div>\n</div><div class=\"white city-intro\">\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-sm-12\">\n<blockquote>With its urban forests, glassy downtown and energetic food scene, it’s easy to be captivated with this coastal city in British Columbia.</blockquote>\n<div class=\"testimonial-attribute\"><img alt=\"New York Times on Vancouver\" src=\"/assets/summit-travel-archive/summit/images/nytimes.png\" /><p>New York Times on Vancouver</p>\n</div>\n</div>\n</div>\n</div>\n</div>",
