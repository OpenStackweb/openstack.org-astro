            {
              "label": "Presentation",
              "url": "/assets/marketing/Newton-release-public.pptx"
            }
          ]
        },
        {
          "id": "release-6",
          "title": "Mitaka",
          "description": "<p>OpenStack Mitaka was the 13th release and offers greater manageability and scalability as well as an enhanced end-user experience.</p>\n<p>The Mitaka release was designed and built by an international community of 2,336 developers, operators and users from 345 organizations.</p>",
          "image": "/assets/marketing/openstack-mitaka-logo-sm2-1.png",
          "imageAlt": "openstack mitaka logo sm2 1",
          "action": {
            "label": "View Release Details >",
