          "imageAlt": "promote page 1",
          "action": {
            "label": "Review Logo Guidelines",
            "url": "http://www.openstack.org/brand/"
          }
        },
        {
          "id": "promote_product-2",
          "title": "Contact the Foundation",
          "description": "<p>Need help navigating the marketing resources? Have a specific question about how to promote your OpenStack product or event? Contact the OpenStack Foundation marketing team.</p>",
          "image": "/assets/marketing/promote-page-2.png",
          "imageAlt": "promote page 2",
          "action": {
            "label": "Contact the Foundation",
            "url": "mailto:marketing@openstack.org"
          }
        },
        {
          "id": "promote_product-3",
          "title": "Promote Your Product",
          "description": "<p>Share your press and help spread the word in the OpenStack ecosystem. Learn <a title=\"How to promote your OpenStack product\" href=\"https://www.openstack.org/make-some-news-with-openstack/\">how you can make some noise about your OpenStack marketing initatives</a>.</p>",
          "image": "/assets/marketing/promote-page-3.png",
          "imageAlt": "promote page 3",
          "action": {
            "label": "Learn More",
            "url": "https://www.openstack.org/marketing/make-some-news-with-openstack/"
          }
        }
      ]
    },
