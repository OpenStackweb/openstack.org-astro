---
import { tinaField } from '@tinacms/astro';
import InlineLinks from '../InlineLinks.astro';
import defaultContent from '../../lib/content/marketplace-details.json';
import catalogue from '../../lib/marketplace/catalog.json';
import { courseDate, courseDays } from '../../lib/marketplace/dates.mjs';
type Provider = (typeof catalogue.categories)[number]['records'][number];
const snapshotSeconds = Date.parse(catalogue.fetchedAt) / 1000;
const {
  record,
  content = defaultContent,
  section = 'overview',
} = Astro.props as {
  record: Provider;
  content?: typeof defaultContent;
  section?: 'overview' | 'details';
};
const serviceRegions = [...new Set(record.offerings.map((offering) => offering.region))].filter(
  Boolean,
);
const sections = [
  { title: content.headings.services, items: record.components },
  { title: content.headings.regions, items: record.regions },
  { title: content.headings.serviceRegions, items: serviceRegions },
  ...record.specifications.map((section) => ({
    ...section,
    title:
      content.specifications[section.key as keyof typeof content.specifications] || section.title,
  })),
].filter((section) => section.items.length);
const linkSections = [
  { title: content.headings.resources, items: record.resources },
  { title: content.headings.caseStudies, items: record.caseStudies },
].filter((section) => section.items.length);
// HTML is sanitized by the API importer before it enters the public snapshot.
---

{section === 'overview' ? (
  <>
    {record.company.logo && (
      <img
        class="provider-logo"
        src={record.company.logo}
        alt={`${record.company.name || record.name} logo`}
      />
    )}
    <div set:html={record.descriptionHtml} />
    <div class="marketplace-qualifications" data-tina-field={tinaField(content, 'qualifications')}>
      {Object.entries(content.qualifications)
        .filter(([key]) =>
          key === 'coaPartner'
            ? record.company.coaPartner
            : record[key as 'tested' | 'bareMetal' | 'federatedIdentity'],
        )
        .map(([, badge]) => (
          <article class="marketplace-qualification">
            {badge.image && <img src={badge.image} alt={badge.title} loading="lazy" />}
            <div>
              <h2>{badge.title}</h2>
              {badge.description && (
                <p>
                  <InlineLinks text={badge.description} />
                </p>
              )}
            </div>
          </article>
        ))}
    </div>
    {record.website && (
      <p>
        <a class="provider-link" href={record.website}>
          {content.actions.website} ↗
        </a>
      </p>
    )}
    {record.company.overviewHtml && (
      <section>
        <h2 data-tina-field={tinaField(content.headings, 'about')}>
          {content.headings.about} {record.company.name}
        </h2>
        <div set:html={record.company.overviewHtml} />
      </section>
    )}
    {record.company.commitmentHtml && (
      <section>
        <h2 data-tina-field={tinaField(content.headings, 'commitment')}>
          {content.headings.commitment}
        </h2>
        <div set:html={record.company.commitmentHtml} />
        {record.company.commitmentAuthor && (
          <p class="marketplace-attribution">
            — {record.company.commitmentAuthor}, {record.company.name}
          </p>
        )}
      </section>
    )}
    <div class="marketplace-specifications">
      {sections.map((section) => (
        <section>
          <h2>{section.title}</h2>
          <ul>
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))}
    </div>
    {linkSections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <ul>
          {section.items.map((item) => (
            <li>
              <a href={item.url}>{item.name}</a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    {!!record.courses.length && (
      <section>
        <h2 data-tina-field={tinaField(content.headings, 'courses')}>{content.headings.courses}</h2>
        {record.courses.map((course) => (
          <section id={`course_${course.id}`} class="marketplace-course">
            <h3>{course.name}</h3>
            <p>
              {[course.type, course.level && `${course.level} ${content.courses.level}`]
                .filter(Boolean)
                .join(' · ')}
            </p>
            <div set:html={course.descriptionHtml} />
            {!!course.projects.length && (
              <ul>
                {course.projects.map((project) => (
                  <li>{project}</li>
                ))}
              </ul>
            )}
            {course.online ? (
              <p>{content.courses.online}</p>
            ) : course.schedules.length ? (
              <div class="marketplace-schedule">
                <table>
                  <caption>{content.courses.caption}</caption>
                  <thead>
                    <tr>
                      <th>{content.courses.location}</th>
                      <th>{content.courses.starts}</th>
                      <th>{content.courses.ends}</th>
                      <th>{content.courses.duration}</th>
                      <th>{content.courses.status}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {course.schedules.map((schedule) => (
                      <tr>
                        <td>{schedule.location || content.courses.unknownLocation}</td>
                        <td>{courseDate(schedule.start)}</td>
                        <td>{courseDate(schedule.end)}</td>
                        <td>
                          {courseDays(schedule.start, schedule.end) === null
                            ? content.courses.unknownDuration
                            : `${courseDays(schedule.start, schedule.end)} ${content.courses.days}`}
                        </td>
                        <td>
                          {schedule.end && schedule.end < snapshotSeconds
                            ? content.courses.past
                            : content.courses.availability}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p>{content.courses.noDates}</p>
            )}
            {course.url && (
              <p>
                <a href={course.url}>{content.actions.course} ↗</a>
              </p>
            )}
          </section>
        ))}
      </section>
    )}
  </>
) : (
  <>
    {!!record.locations.length && (
      <section>
        <h2 data-tina-field={tinaField(content.headings, 'locations')}>
          {content.headings.locations}
        </h2>
        <ul>
          {record.locations.map((location) => (
            <li>
              {[location.city, location.country, location.region].filter(Boolean).join(' · ')}
              {location.endpoint && (
                <>
                  {' '}
                  · <a href={location.endpoint}>{content.actions.endpoint}</a>
                </>
              )}
              {!!location.availabilityZones.length && (
                <p>
                  {content.locations.zones}: {location.availabilityZones.join(', ')}
                </p>
              )}
            </li>
          ))}
        </ul>
      </section>
    )}
    {record.videos.length > 0 && (
      <section>
        <h2 data-tina-field={tinaField(content.headings, 'videos')}>{content.headings.videos}</h2>
        <div class="marketplace-videos">
          {record.videos.map((video) => (
            <figure>
              <iframe
                loading="lazy"
                title={video.name || 'Provider video'}
                src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
              <figcaption>{video.name}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

  </>
)}
