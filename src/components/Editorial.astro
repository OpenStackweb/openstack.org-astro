---
import ConferenceHeader from './ConferenceHeader.astro';
import ArchiveFaq from './ArchiveFaq.astro';
import ArchiveLocations from './ArchiveLocations.astro';
import ArchiveVenueLinks from './ArchiveVenueLinks.astro';
import ScienceBook from './ScienceBook.astro';
import SponsorArchive from './SponsorArchive.astro';
import IndustryNewsletter from './IndustryNewsletter.astro';
import IndustryHero from './IndustryHero.astro';
const { page } = Astro.props;
---

<main
  id="main"
  class:list={[
    'editorial-page',
    {
      'has-industry-hero': Boolean(page.hero),
      'city-guide': page.html?.includes('featured-guide-row'),
      'boston-city-guide': page.path === '/summit/boston-2017/boston-city-guide/',
    },
  ]}
>
  {page.archivePresentation && <ConferenceHeader page={page} />}
  {page.hero && <IndustryHero title={page.title} content={page.hero} />}
  {!page.sectionNavigation?.length && (
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/">OpenStack</a> / <span>{page.title}</span>
    </nav>
  )}
  <div class:list={['editorial-layout', { 'with-sidebar': page.sectionNavigation?.length, 'conference-layout': Boolean(page.conference) }]}>
    <article>
      {!page.hero && <h1 class:list={{'conference-title-accessible': Boolean(page.conference)}}>{page.title}</h1>}
      {page.archiveNotice && <p class="archive-notice">{page.archiveNotice}</p>}
      {page.archiveIntroductionHtml && !page.archivePresentation && (
        <div class="prose archive-introduction" set:html={page.archiveIntroductionHtml} />
      )}
      <div class="prose article-body" set:html={page.html} />
      {page.faq && <ArchiveFaq content={page.faq} />}
      {page.locations?.length > 0 && <ArchiveLocations locations={page.locations} />}
      {page.scienceBook && <ScienceBook content={page.scienceBook} />}
      {page.newsletter && <IndustryNewsletter content={page.newsletter} />}
      {page.sponsors && <SponsorArchive content={page.sponsors} />}
      {page.conference && (
        <section class="conference-news" aria-labelledby="conference-news-title">
          <h2 id="conference-news-title">{page.conference.newsTitle}</h2>
          <a href={`${page.path}rss`}>RSS updates</a>
          {page.conference.updates.map((update: any) => (
            <section class="news-item">
              <h2>{update.title}</h2>
              <p class="post-date">Posted: {update.dateLabel}</p>
              <div class="prose" set:html={update.html} />
            </section>
          ))}
          <div class="prose" set:html={page.conference.reminderHtml} />
        </section>
      )}
      {page.contributors?.length > 0 && (
        <section aria-labelledby="contributors">
          <h2 id="contributors">Contributor List</h2>
          <p>{page.contributorIntroduction}</p>
          <ul class="contributors">
            {page.contributors.map((name: string) => (
              <li>{name}</li>
            ))}
          </ul>
        </section>
      )}
    </article>
    {page.sectionNavigation?.length > 0 && (
      <nav aria-label="Section navigation" class="section-navigation">
        {page.sectionNavigation.map((item: { url: string; label: string }) => (
          <a href={item.url} aria-current={item.url === page.path ? 'page' : undefined}>
            {item.label} →
          </a>
        ))}
        {page.archiveResourcesHtml && (
          <div class="archive-resources" set:html={page.archiveResourcesHtml} />
        )}
      </nav>
    )}
    {page.conference?.sidebarHtml && (
      <aside class="prose conference-details" aria-label="Historical event details" set:html={page.conference.sidebarHtml} />
    )}
  </div>
</main>
{page.venueLinks && <ArchiveVenueLinks links={page.venueLinks} />}

<style>
  .conference-title-accessible { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .conference-news {
    margin-top: 28px;
  }
  .news-item {
    border-top: 1px solid #d4dce1;
    padding: 24px 0;
  }
  .news-item h2 {
    color: #004976;
    font-size: 25px;
    font-weight: 300;
  }
  .post-date {
    font-size: 13px;
  }
  .conference-details {
    font-size: 14px;
    grid-column: 3;
    grid-row: 1;
  }
  .editorial-layout.with-sidebar.conference-layout {
    grid-template-columns: 190px minmax(0, 1fr) 190px;
    gap: 32px;
  }
  .archive-introduction {
    margin-bottom: 28px;
  }
  .archive-resources {
    margin-top: 24px;
    font-size: 13px;
    line-height: 1.6;
  }
  .archive-notice {
    padding: 16px 20px;
    border-left: 4px solid #29abe2;
    background: #edf2f7;
    margin-bottom: 28px;
    font-size: 14px;
    line-height: 1.6;
  }
  .editorial-page {
    color: #334e60;
    max-width: 1160px;
    margin: 0 auto;
    padding: 36px 24px 72px;
  }
  .editorial-layout.with-sidebar {
    display: grid;
    grid-template-columns: 215px minmax(0, 1fr);
    gap: 68px;
  }
  .editorial-page.has-industry-hero {
    max-width: none;
    padding: 0 0 4.5rem;
  }
  .has-industry-hero > .breadcrumb,
  .has-industry-hero > .editorial-layout {
    max-width: 1112px;
    margin: 2rem auto;
    padding-inline: 1.5rem;
  }
  .with-sidebar article {
    grid-column: 2;
    grid-row: 1;
  }
  .with-sidebar h1 {
    font-size: clamp(28px, 3vw, 36px);
    font-weight: 300;
    text-align: center;
    margin-bottom: 36px;
  }
  .with-sidebar .prose {
    font-size: 14px;
    line-height: 1.5;
  }
  .with-sidebar .prose :global(h2) {
    font-size: 30px;
    font-weight: 300;
    margin-top: 20px;
  }
  .with-sidebar .prose :global(h3) {
    font-size: 24px;
    font-weight: 400;
    margin-top: 18px;
  }
  .section-navigation {
    grid-column: 1;
    grid-row: 1;
    align-self: start;
    display: grid;
    gap: 0;
    border: none;
  }
  .section-navigation a {
    display: block;
    color: #2a536e;
    padding: 15px;
    margin-bottom: 18px;
    font-size: 12px;
    text-transform: uppercase;
    text-decoration: none;
  }
  .section-navigation a[aria-current='page'] {
    background: #edf4f7;
    font-weight: 700;
  }
  .section-navigation a:focus-visible {
    outline: 3px solid #e60039;
  }
  @media (max-width: 760px) {
    .editorial-layout.with-sidebar {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .with-sidebar article,
    .section-navigation,
    .conference-details {
      grid-column: auto;
      grid-row: auto;
    }
    .editorial-layout.with-sidebar.conference-layout { grid-template-columns: 1fr; }
  }
  .breadcrumb {
    margin-bottom: 32px;
    font-size: 14px;
  }
  article {
    max-width: 860px;
  }
  .contributors {
    columns: 3 200px;
    padding-left: 20px;
    line-height: 1.7;
  }
  .contributors li {
    break-inside: avoid;
    overflow-wrap: anywhere;
  }
  h1 {
    color: #004976;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    margin: 0 0 28px;
  }
  .prose :global(p) {
    color: inherit;
  }
  .prose {
    font-size: 17px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.2em;
  }
  .prose :global(h2),
  .prose :global(h3) {
    color: #004976;
    margin: 1.5em 0 0.6em;
    line-height: 1.3;
  }
  .prose :global(li) {
    margin-bottom: 0.4em;
  }
  .prose :global(a.start-btn) {
    display: inline-block;
    padding: 12px 24px;
    background: #30739c;
    color: white;
    text-decoration: none;
    border-radius: 3px;
  }
  .prose :global(iframe) {
    display: block;
    width: 100%;
    max-width: 760px;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
    margin: 24px 0;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
  }
  .prose :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 10px;
    border: 1px solid #d4dce1;
  }
  .prose :global(pre) {
    overflow-x: auto;
  }
  .prose :global(a) {
    text-decoration: underline;
  }
  .prose :global(.archive-landing > div) {
    margin-block: 32px;
  }
  .prose :global(.archive-landing .guide-listing) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
    gap: 28px;
    margin-block: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid #d4dce1;
  }
  .prose :global(.archive-landing .featured) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px;
    margin-block: 32px;
  }
  .prose :global(.archive-landing .guide-nav a),
  .prose :global(.archive-landing .featured a) {
    display: inline-block;
    margin-right: 16px;
  }
  .prose :global(.archive-landing .image-wrapper img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  @font-face {
    font-family: 'Archive Guide Icons';
    src: url('/fonts/archive-guide-icons.woff2') format('woff2');
    font-display: block;
  }
  .city-guide .prose :global(.guide-nav) {
    margin: 20px 0;
    padding: 20px 12px;
    background: #29abe2;
  }
  .city-guide .prose :global(.guide-icons-wrapper) {
    display: flex;
    gap: 12px;
  }
  .city-guide .prose :global(.guide-nav a.guide-icons) {
    flex: 1;
    min-width: 0;
    margin: 0;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    color: white;
    font-size: 12px;
  }
  .city-guide .prose :global(.guide-nav a:focus-visible) {
    outline: 3px solid #173b52;
    outline-offset: 5px;
  }
  .city-guide .prose :global(.guide-nav a:hover) {
    text-decoration: underline;
  }
  .city-guide .prose :global(.guide-nav .fa) {
    display: block;
    margin-bottom: 10px;
    font-family: 'Archive Guide Icons';
    font-style: normal;
    font-size: 30px;
    line-height: 1;
  }
  .city-guide .prose :global(.guide-nav .fa-music::before) { content: '\f001'; }
  .city-guide .prose :global(.guide-nav .fa-cutlery::before) { content: '\f0f5'; }
  .city-guide .prose :global(.guide-nav .fa-beer::before) { content: '\f0fc'; }
  .city-guide .prose :global(.guide-nav .fa-tree::before) { content: '\f1bb'; }
  .city-guide .prose :global(.guide-nav .fa-institution::before) { content: '\f19c'; }
  .city-guide .prose :global(.guide-nav .fa-map-signs::before) { content: '\f277'; }
  @media (max-width: 767px) {
    .city-guide .prose :global(.guide-nav a.guide-icons) { font-size: 10px; }
    .city-guide .prose :global(.guide-icons-wrapper) { gap: 6px; }
  }
  /* Historical city guides share cards, rather than the generic feature rows. */
  .city-guide article {
    max-width: none;
  }
  .city-guide .prose {
    font-size: 14px;
    line-height: 1.5;
  }
  .prose :global(.featured-guide-row) {
    display: flex;
    gap: 20px;
    margin-block: 20px 30px;
  }
  .prose :global(.archive-landing .featured-guide-row .featured) {
    display: block;
    flex: 1;
    min-width: 0;
    margin: 0;
    border: 1px solid #d4dce5;
    border-radius: 4px;
    overflow: hidden;
  }
  .prose :global(.featured-guide-row .image-wrapper) {
    height: 180px;
    overflow: hidden;
  }
  .prose :global(.archive-landing .featured-guide-row .image-wrapper img) {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }
  .prose :global(.featured-guide-row .featured-content) {
    padding: 5px 10px 10px;
  }
  .prose :global(.featured-guide-row h5) {
    color: #2a4e68;
    margin: 10px 0;
    font-size: 14px;
  }
  .prose :global(.featured-guide-row .address) {
    font-size: 0.9em;
    font-weight: 600;
    margin: 5px 0 10px;
  }
  .prose :global(.featured-guide-row p) {
    font-size: 0.9em;
    margin-bottom: 10px;
  }
  .prose :global(.archive-landing .featured-guide-row a.featured-site) {
    margin: 5px 4px 0 0;
    padding: 3px 7px;
    border: 1px solid #30739c;
    border-radius: 4px;
    text-decoration: none;
  }
  .prose :global(.featured-guide-row .featured-content p > span) {
    display: none;
  }
  .prose :global(.section-title.guide) {
    padding: 10px 20px;
    background: #edf2f7;
    text-transform: uppercase;
    border-radius: 3px;
    scroll-margin-top: 20px;
  }
  .city-guide .prose :global(.guide-listing) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-block: 0 10px;
    padding: 10px 0;
    border-color: #edf2f7;
  }
  .prose :global(.guide-name) {
    font-weight: 600;
  }
  @media (max-width: 767px) {
    .prose :global(.featured-guide-row) {
      display: block;
    }
    .prose :global(.archive-landing .featured-guide-row .featured) {
      display: grid;
      grid-template-columns: minmax(0, 30fr) minmax(0, 70fr);
      gap: 0;
      margin-block: 10px;
    }
    .prose :global(.featured-guide-row .image-wrapper) {
      height: 100%;
      min-height: 180px;
    }
    .city-guide .prose :global(.guide-listing) {
      grid-template-columns: minmax(0, 1fr);
      gap: 5px;
    }
    .boston-city-guide .prose :global(.featured-guide-row .image-wrapper) {
      display: none;
    }
    .boston-city-guide .prose :global(.archive-landing .featured-guide-row .featured) {
      display: block;
      border: 0;
      border-bottom: 1px solid #edf2f7;
      border-radius: 0;
    }
    .boston-city-guide .prose :global(.featured-guide-row a.featured-site) {
      border: 0;
      padding: 0;
    }
  }
  .prose :global(.archive-landing figure) {
    margin: 24px 0;
  }
  .prose :global(.archive-landing .archive-details) {
    padding: 20px;
    background: #f1f6f8;
  }
  .prose :global(.archive-landing summary) {
    cursor: pointer;
    font-weight: 600;
  }
  .prose :global(.industry-content > div) {
    margin-block: 2rem;
  }
  .prose :global(.industry-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 2rem;
    margin-block: 1.5rem;
  }
  .prose :global(.industry-card) {
    min-width: 0;
  }
  .prose :global(.industry-card img) {
    max-height: 24rem;
    object-fit: contain;
  }
  @media (max-width: 640px) {
    .prose :global(.archive-landing .guide-listing),
    .prose :global(.archive-landing .featured) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
