---
const { name } = Astro.props;
---

<svg viewBox="0 0 48 48" aria-hidden="true">
  {name === 'play' && <><circle cx="24" cy="24" r="21" /><path d="m19 14 15 10-15 10Z" /></>}
  {name === 'dollar' && <path d="M24 3v42M36 12c-4-7-25-7-25 4 0 12 26 4 26 17 0 11-22 12-27 3" />}
  {name === 'check' && <path d="m6 25 12 12L42 11" />}
  {name === 'fork' && (
    <>
      <circle cx="13" cy="7" r="4" /><circle cx="13" cy="41" r="4" /><circle cx="35" cy="12" r="4" />
      <path d="M13 11v26m0-10c0-9 22 0 22-11" />
    </>
  )}
  {name === 'gears' && (
    <>
      <circle cx="18" cy="25" r="10" /><circle cx="18" cy="25" r="3" />
      <path d="M18 10v5m0 20v5M3 25h5m20 0h5M7 14l4 4m14 14 4 4M7 36l4-4m14-14 4-4" />
      <circle cx="36" cy="10" r="5" /><path d="M36 2v3m0 10v3m-8-8h3m10 0h3" />
    </>
  )}
  {name === 'server' && (
    <>
      {[4, 19, 34].map(y => <><rect x="4" y={y} width="40" height="10" rx="2" /><path d={`M33 ${y + 5}h4`} /></>)}
    </>
  )}
  {name === 'monitor' && (
    <>
      <rect x="4" y="5" width="40" height="29" rx="2" />
      <path d="M24 34v8M14 42h20" />
    </>
  )}
  {name === 'people' ? (
    <>
      <circle cx="24" cy="12" r="6"></circle>
      <circle cx="9" cy="18" r="4"></circle>
      <circle cx="39" cy="18" r="4"></circle>
      <path d="M13 42V32a11 11 0 0 1 22 0v10M2 40V31a7 7 0 0 1 8-7M46 40V31a7 7 0 0 0-8-7"></path>
    </>
  ) : (
    <>
      {name === 'sliders' ? (
        <>
          <path d="M3 10h42M3 24h42M3 38h42"></path>
          <circle cx="15" cy="10" r="4"></circle>
          <circle cx="33" cy="24" r="4"></circle>
          <circle cx="20" cy="38" r="4"></circle>
        </>
      ) : (
        <>
          {name === 'branches' ? (
            <>
              <path d="M3 10h8c12 0 14 28 26 28h8M3 38h8c12 0 14-28 26-28h8M37 2l8 8-8 8M37 30l8 8-8 8"></path>
            </>
          ) : (
            <>
              {name === 'briefcase' ? (
                <>
                  <rect x="4" y="14" width="40" height="28" rx="3"></rect>
                  <path d="M16 14V7h16v7M4 25h40M20 24v6h8v-6"></path>
                </>
              ) : (
                <>
                  {name === 'code' ? (
                    <>
                      <path d="m17 12-12 12 12 12m14-24 12 12-12 12M28 5l-8 38"></path>
                    </>
                  ) : (
                    <>
                      {name === 'ticket' ? (
                        <>
                          <path d="M5 9h38v10a5 5 0 0 0 0 10v10H5V29a5 5 0 0 0 0-10Z M32 10v28"></path>
                        </>
                      ) : (
                        <>
                          {name === 'document' ? (
                            <>
                              <path d="M10 3h18l10 10v32H10ZM28 3v12h10M16 23h16M16 30h16M16 37h12"></path>
                            </>
                          ) : null}
                        </>
                      )}
                    </>
                  )}
                </>
              )}
            </>
          )}
        </>
      )}
    </>
  )}
</svg>

<style>
  svg {
    width: 58px;
    height: 58px;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    margin: 10px 0 20px;
  }
</style>
