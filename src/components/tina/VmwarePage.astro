---
import MarketingLanding from '../MarketingLanding.astro';
import { prepareVmwareMigration } from '../../lib/server/vmware-migration.mjs';
const content = prepareVmwareMigration(Astro.props.content);
const planning = content.planningBanner;
const features = content.migrationFeatures;
const guide = content.migrationGuide;
---
  <MarketingLanding
    content={content}
    introductionGap={16}
    memberTitleGap={30}

    canonical="https://www.openstack.org/vmware-migration-to-openstack/"
  >
    <Fragment slot="before-members">
      <section class="planning container" aria-label={planning.title}>
        <div class="planning-wrapper">
          <div
            class="planning-copy"
            style={{ '--planning-background': `url(${JSON.stringify(planning.background)})` }}
          >
            <h2>{planning.title}</h2>
            <p>{planning.abstract}</p>
            <a class="vmware-button" href={planning.ctaButton.url}>
              {planning.ctaButton.title}
              <span aria-hidden="true">➜</span>
            </a>
          </div>
          <div class="planning-image">
            <img src={planning.image} alt="" loading="lazy" />
          </div>
        </div>
      </section>

      <section class="vmware-comparison container" aria-label="Feature comparison">
        <div class="section-title">
          <Fragment set:html={features.html} />
        </div>
        <table>
          <thead>
            <tr>
              <th scope="col">{content.labels.openstack}</th>
              <th scope="col">{content.labels.vmware}</th>
            </tr>
          </thead>
          <tbody>
            {features.rows.map((row: ({ title: string; abstract: string } | null)[]) => (
              <>
                <tr>
                  {row.map((feature: { title: string; abstract: string } | null) => (
                    <>
                      <td>
                        {feature && (
                          <>
                            <strong>{feature.title}</strong>
                            <p>{feature.abstract}</p>
                          </>
                        )}
                      </td>
                    </>
                  ))}
                </tr>
              </>
            ))}
            <tr class="table-footer">
              <td colspan="2">
                <a class="vmware-button" href={features.ctaButton.url}>
                  {features.ctaButton.title}
                  <span aria-hidden="true">➜</span>
                </a>
              </td>
            </tr>
          </tbody>
        </table>
        <p class="source">
          {content.labels.source}
          <a href={features.sourceLink.link}>{features.sourceLink.text}</a>
        </p>
      </section>
    </Fragment>

    <Fragment slot="after-members">
      <section class="tools" aria-label="Migration tools">
        <div class="section-title container">
          <Fragment set:html={content.successCases.html} />
        </div>
        <div class="tool-cards">
          {content.successCases.tools.map(
            (tool: { title: string; image: string; learnMoreUrl: string }) => (
              <>
                <article>
                  <h3>{tool.title}</h3>
                  <img src={tool.image} alt="" loading="lazy" />
                  <a
                    href={tool.learnMoreUrl}
                    aria-label={`${content.labels.learnMore}: ${tool.title}`}
                  >
                    {content.labels.learnMore}
                    <span aria-hidden="true">›</span>
                  </a>
                </article>
              </>
            ),
          )}
        </div>
      </section>

      <section class="survey container" aria-label="Member survey">
        <div
          class="survey-question"
          style={{ 'background-image': `url(${JSON.stringify(guide.leftColumn.image)})` }}
        >
          <Fragment set:html={guide.leftColumn.html} />
        </div>
        <div class="metrics">
          {[guide.rightColumn.requestMetric, guide.rightColumn.successMetric].map(
            (metric, index) => (
              <>
                <div class="metric">
                  <div
                    class="metric-fill"
                    class:list={{ success: index === 1 }}
                    style={{ width: `${metric.percentage}%` }}
                  ></div>
                  <div class="metric-copy" style={{ '--metric-width': `${metric.percentage}%` }}>
                    <p class="percentage">{metric.percentage} %</p>
                    <div>
                      <Fragment set:html={metric.html} />
                    </div>
                  </div>
                </div>
              </>
            ),
          )}
        </div>
      </section>
    </Fragment>
  </MarketingLanding>

  <style>
    .container {
      max-width: 1280px;
      padding: 0 24px;
      margin-left: auto;
      margin-right: auto;
    }
    .vmware-button {
      display: inline-block;
      padding: 10px 25px;
      background: #ed1944;
      color: white;
      font-size: 14px;
      font-weight: 600;
      line-height: 20px;
      border-radius: 2px;
    }
    .vmware-button span {
      margin-left: 8px;
    }
    .vmware-button:hover {
      background: #831917;
      text-decoration: none;
    }
    .planning {
      margin-top: 104px;
    }
    .planning-wrapper {
      background: #2a4e68;
      display: flex;
    }
    .planning-copy {
      position: relative;
      padding: 80px 0 80px 80px;
      color: white;
      z-index: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .planning-copy::before {
      content: '';
      position: absolute;
      inset: 0;
      width: 50%;
      height: 150%;
      background-image: var(--planning-background);
      background-repeat: no-repeat;
      background-size: cover;
      background-position: 0 -180px;
      z-index: -1;
    }
    .planning h2 {
      font-size: 30.4px;
      line-height: 40px;
      font-weight: 500;
      color: white;
      margin-bottom: 14.4px;
    }
    .planning-copy p {
      font-size: 20.8px;
      line-height: 1.35;
      margin-bottom: 40px;
      width: 70%;
    }
    .planning-copy .vmware-button {
      margin-top: auto;
      align-self: start;
    }
    .planning-image {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 405px;
    }
    .planning-image img {
      width: 100%;
      height: auto;
      max-width: 405px;
      max-height: 405px;
      aspect-ratio: 1;
    }
    .vmware-comparison {
      margin-top: 99.2px;
    }
    .section-title {
      font-weight: 300;
      font-size: 30.4px;
      line-height: 32px;
      color: #00497b;
    }
    .section-title :global(strong) {
      font-weight: 500;
    }
    table {
      width: 100%;
      table-layout: fixed;
      border-collapse: collapse;
      margin-top: 48px;
    }
    th,
    td {
      padding: 40px;
      text-align: left;
      border: 1px solid #e7e7e7;
      vertical-align: top;
      overflow-wrap: anywhere;
    }
    th {
      width: 50%;
      background: #edf2f7;
      color: #2a4e68;
      font-weight: 600;
      font-size: 19.2px;
      line-height: 40px;
      letter-spacing: -0.2px;
    }
    th:first-child {
      background: #ed1944;
      color: white;
    }
    td strong {
      font-weight: 500;
      font-size: 19.2px;
      line-height: 40px;
      letter-spacing: -0.2px;
      color: #30739c;
    }
    td p {
      margin: 14px 0;
      font-size: 14px;
      line-height: 25.6px;
    }
    .table-footer {
      background: #e7e7e7;
    }
    .table-footer td {
      padding: 60px;
      text-align: center;
    }
    .source {
      margin-top: 17.6px;
      font-size: 12px;
      font-style: italic;
      line-height: 17.6px;
    }
    .source a {
      text-decoration: underline;
    }
    .tools {
      margin-top: 128px;
      padding: 128px 0;
      background: #edf2f7;
    }
    .tools .section-title {
      text-align: center;
      font-size: 30px;
      line-height: 40px;
    }
    .tool-cards {
      margin-top: 80px;
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      justify-content: center;
    }
    article {
      min-height: 274px;
      width: 320px;
      max-width: calc(100% - 32px);
      padding: 20px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: white;
    }
    article h3 {
      color: #00497b;
      font-size: 19.2px;
      line-height: 1.2;
      letter-spacing: -0.2px;
      font-weight: 500;
    }
    article img {
      max-height: 116px;
      width: auto;
      object-fit: scale-down;
    }
    article a {
      border: 1px solid #bc1518;
      border-radius: 5px;
      color: #bc1518;
      font-size: 14px;
      line-height: 20px;
      text-transform: uppercase;
      padding: 12.8px;
      text-align: center;
    }
    article a span {
      margin-left: 13px;
    }
    .survey {
      margin-top: 144px;
      display: flex;
      gap: 16px;
      height: 568px;
    }
    .survey-question {
      width: 50%;
      font-size: 36px;
      font-weight: 500;
      line-height: 1.25;
      letter-spacing: -0.2px;
      color: white;
      background-color: #ed1944;
      padding: 56px 40px 40px;
      background-repeat: no-repeat;
      background-position: 85% 90%;
    }
    .survey-question :global(p) {
      width: 80%;
    }
    .metrics {
      width: 50%;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .metric {
      flex: 1;
      position: relative;
      background: #cbe8f2;
    }
    .metric-fill {
      position: absolute;
      inset: 0 auto 0 0;
      background: #0188b6;
    }
    .metric-fill.success {
      background: #00bffe;
    }
    .metric-copy {
      position: relative;
      width: var(--metric-width);
      min-width: 50%;
      padding: 56px 32px;
      color: white;
      font-size: 19.2px;
      font-weight: 500;
      line-height: 1.25;
    }
    .percentage {
      font-size: 108px;
      line-height: 40px;
      letter-spacing: -6px;
      font-weight: 400;
      margin-bottom: 24px;
      white-space: nowrap;
    }
    @media (max-width: 1200px) {
      .planning-copy::before {
        width: 55%;
      }
    }
    @media (max-width: 1080px) {
      .planning-copy::before {
        width: 65%;
      }
    }
    @media (max-width: 910px) {
      .planning-copy::before {
        width: 75%;
      }
    }
    @media (max-width: 790px) {
      .planning-wrapper {
        flex-direction: column;
      }
      .planning-copy {
        padding: 40px;
      }
      .planning-copy::before {
        background-position: 0 10%;
        width: 100%;
        height: 90%;
      }
      .planning-image {
        width: 100%;
      }
      .planning-image img {
        max-width: 250px;
        max-height: 250px;
      }
      th,
      td {
        padding: 16px;
      }
      .table-footer td {
        padding: 24px;
      }
      .survey {
        flex-direction: column;
        height: auto;
      }
      .survey-question {
        width: 100%;
        padding: 24px 40px 208px;
        background-position: 50% 95%;
      }
      .survey-question :global(p) {
        width: 100%;
      }
      .metrics {
        width: 100%;
      }
      .metric {
        min-height: 330px;
      }
      .metric-copy {
        width: 100%;
        color: #00131c;
      }
      .percentage {
        font-size: 67.2px;
      }
    }
  </style>
