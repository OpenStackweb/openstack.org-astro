---
import { tinaField } from '@tinacms/astro';
import MarketplaceShared from './MarketplaceShared.astro';
import InlineLinks from '../InlineLinks.astro';
import { contentHref } from '../../lib/content-links.mjs';
const { content, section = 'header' } = Astro.props;
---

{section === 'resources' ? (
  <>
    <MarketplaceShared content={content.resources} />
    <aside class="marketplace-notice" data-tina-field={tinaField(content, 'contact')}>
      <InlineLinks text={content.contact || ''} />
    </aside>
  </>
) : section === 'icon' ? (
  <>
    {content.icon && (
      <img data-tina-field={tinaField(content, 'icon')} src={contentHref(content.icon)} alt="" />
    )}
    <span
      data-tina-field={tinaField(content, content.navigationLabel ? 'navigationLabel' : 'title')}
    >
      {content.navigationLabel || content.title}
    </span>
  </>
) : section === 'header' ? (
  <>
    <h1 data-tina-field={tinaField(content, 'title')}>{content.title}</h1>
    {content.introduction && (
      <div class="marketplace-introduction" data-tina-field={tinaField(content, 'introduction')}>
        <InlineLinks text={content.introduction} />
      </div>
    )}
  </>
) : (
  <>
    {content.contact && (
      <aside class="marketplace-notice" data-tina-field={tinaField(content, 'contact')}>
        <InlineLinks text={content.contact} />
      </aside>
    )}
  </>
)}
