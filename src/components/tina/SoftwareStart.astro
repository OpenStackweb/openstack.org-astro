---
import InlineLinks from '../InlineLinks.astro';
import { tinaField } from '@tinacms/astro';
import { prepareSoftwareStart } from '../../lib/server/software-start.mjs';
import { reviewHref } from '../../lib/legacy-routes.js';
import '../../lib/software/software.css';
const { content: raw } = Astro.props;
const content = prepareSoftwareStart(raw);
type StartItem = { title: string; content?: string; logo?: string; actions?: { label: string; url: string }[]; list?: { title: string; url: string }[] };
const sections = [
  ...(content.showTrySection === false ? [] : [{key:'trySection', ...content.trySection}]),
  {key:'deploy', title:content.deploy.title, summary:content.deploy.summary, content:[content.deploy.distributions,content.deploy.howto,content.deploy.companies,content.deploy.download,content.deploy.tools]},
  ...(content.contribute ? [{key:'contribute', ...content.contribute}] : []),
  {key:'learn', ...content.learn},
  ...(content.showNextSteps === false ? [] : [{key:'nextSteps', ...content.nextSteps}]),
];
---
<main id="main" class="software-app">
  <a href="/software/">← Browse software</a>
  <h1 data-tina-field={tinaField(raw, 'title')}>{content.title}</h1>
  {sections.map(section => <section data-tina-field={tinaField(raw, section.key)}>
    <h2>{section.title}</h2>
    {section.summary && <p><InlineLinks text={section.summary} /></p>}
    <div class="start-grid">
      {section.content.map((item: StartItem) => <article>
        <h3><InlineLinks text={item.title} /></h3>
        {item.logo && <img class="start-logo" src={item.logo} alt="" />}
        {item.content && <p><InlineLinks text={item.content} /></p>}
        {item.list && <ul>{item.list.map(link => <li><a href={reviewHref(link.url)}>{link.title}</a></li>)}</ul>}
        {(item.actions || []).map(action => <a class="start-action" href={reviewHref(action.url)}>{action.label}</a>)}
      </article>)}
    </div>
  </section>)}
</main>
<style>
.start-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:32px; }
.start-logo { width:110px; float:right; margin:12px; }
.start-action { display:inline-block; border:1px solid #2a526c; padding:8px 12px; margin:8px 8px 8px 0; }
article { border-top:1px solid #ddd; padding-bottom:24px; }
@media(max-width:650px) { .start-grid { grid-template-columns:1fr; } }
</style>
