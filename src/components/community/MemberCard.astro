---
import MemberPortrait from './MemberPortrait.astro';
const { person, manager, labels } = Astro.props;
---

<article class="member-card">
  <div class:list={['portrait', { monochrome: !manager }]}>
    {!manager && person.x ? (
      <a
        href={person.x}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${person.name} on ${labels.x}`}
      >
        <MemberPortrait person={person} />
      </a>
    ) : (
      <MemberPortrait person={person} />
    )}
  </div>
  <p>
    <strong>{person.name}</strong>
    <br />
    {person.location}
  </p>
  {manager ? (
    <>
      <div class="social-links">
        {person.x ? (
          <>
            <a
              href={person.x}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${person.name} on ${labels.x}`}
            >
              𝕏
            </a>
          </>
        ) : null}
        {person.linkedIn ? (
          <>
            <a
              href={person.linkedIn}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${person.name} on ${labels.linkedIn}`}
            >
              in
            </a>
          </>
        ) : null}
        <a
          href={person.profile}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${labels.profile}: ${person.name}`}
        >
          <img src="/images/software-overview/software-openstack-logo.svg" alt="" />
        </a>
      </div>
    </>
  ) : null}
</article>

<style>
  .member-card {
    color: #3979a0;
    font-size: 14px;
    min-height: 260px;
    width: 165px;
  }
  .portrait {
    width: 160px;
    height: 160px;
    overflow: hidden;
  }
  .portrait a {
    display: block;
    height: 100%;
  }
  .monochrome {
    filter: grayscale(1);
  }
  p {
    margin: 0;
    line-height: 24px;
  }
  .social-links {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    align-items: center;
  }
  .social-links a {
    font-size: 25px;
    line-height: 25px;
    font-weight: 600;
  }
  .social-links img {
    width: 25px;
    height: 25px;
    object-fit: contain;
  }
  @media (max-width: 899px) {
    .member-card {
      text-align: center;
    }
    .social-links {
      justify-content: center;
    }
  }
</style>
