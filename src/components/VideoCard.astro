---
const { video } = Astro.props;
const date = new Date(video.publishedAt).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const watchUrl = `https://www.youtube.com/watch?v=${video.id}`;
---

<article class="video-card">
  <youtube-video data-video-id={video.id} data-title={video.title}>
    <div class="player">
      <a href={watchUrl} aria-label={`Watch ${video.title} on YouTube`}>
        <img
          src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
          alt=""
          width="480"
          height="360"
          loading="lazy"
        />
      </a>
      {video.embeddable && (
        <button type="button" aria-label={`Play ${video.title}`} hidden>
          <span aria-hidden="true">▶</span> Play video
        </button>
      )}
    </div>
  </youtube-video>
  <div class="video-copy">
    <h3>
      <a href={watchUrl}>{video.title}</a>
    </h3>
    <p class="metadata">
      <time datetime={video.publishedAt}>{date}</time>
      {Number.isSafeInteger(video.views) && (
        <Fragment>
          <span aria-hidden="true"> · </span>
          {new Intl.NumberFormat('en-US').format(video.views)} views
        </Fragment>
      )}
    </p>
    <a class="youtube-link" href={watchUrl}>
      Watch on YouTube ↗
    </a>
  </div>
</article>
<script>
  class YouTubeVideo extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button');
      const player = this.querySelector('.player');
      if (!button || !player || button.dataset.ready) return;
      button.dataset.ready = 'true';
      button.hidden = false;
      button.addEventListener(
        'click',
        () => {
          if (!/^[A-Za-z0-9_-]{11}$/.test(this.dataset.videoId || '')) return;
          const frame = document.createElement('iframe');
          frame.src = `https://www.youtube-nocookie.com/embed/${this.dataset.videoId}?autoplay=1`;
          frame.title = this.dataset.title || 'OpenStack video';
          frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          frame.allowFullscreen = true;
          frame.referrerPolicy = 'strict-origin-when-cross-origin';
          player.replaceChildren(frame);
          frame.focus();
        },
        { once: true },
      );
    }
  }
  if (!customElements.get('youtube-video')) customElements.define('youtube-video', YouTubeVideo);
</script>
<style>
  .video-card {
    border: 1px solid #dce4e8;
    border-radius: 5px;
    overflow: hidden;
    background: white;
  }
  youtube-video {
    display: block;
  }
  .player {
    aspect-ratio: 16 / 9;
    background: #172e40;
    position: relative;
  }
  .player a {
    display: block;
    height: 100%;
  }
  .player img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .player :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  button {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: #005481;
    color: white;
    border: 2px solid white;
    border-radius: 3px;
    padding: 9px 12px;
    cursor: pointer;
    font: inherit;
  }
  button[hidden] {
    display: none;
  }
  button:focus-visible,
  a:focus-visible {
    outline: 3px solid #ed1944;
    outline-offset: 3px;
  }
  .video-copy {
    padding: 20px;
  }
  h3 {
    margin: 0 0 14px;
    font-size: 20px;
    line-height: 1.4;
  }
  h3 a {
    color: #005481;
  }
  .metadata {
    font-size: 14px;
    color: #52636e;
    margin: 0 0 16px;
  }
  .youtube-link {
    font-size: 14px;
  }
</style>
