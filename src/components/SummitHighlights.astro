---
const { page } = Astro.props;
const content = page.highlights;
let selected = 0;
const keynote = content.keynotes[selected] || content.keynotes[0];
---

<main id="main" class="summit-highlights">
  <header class="summit-hero" style={{ 'background-image': `url('${content.hero.image}')` }}>
    <img
      class="summit-logo"
      src="/assets/summit-landing-archive/b25f8d8d1d6c/summit-logo-small-white.svg"
      alt="OpenStack Summit"
    />
    <h1 class="event-name">{page.title}</h1>
    <nav aria-label="Summit navigation">
      {content.navigation.map((item: any) => (
        <>
          <a href={item.url} aria-current={item.url === page.path ? 'page' : undefined}>
            {item.label}
          </a>
        </>
      ))}
    </nav>
    {content.hero.credit ? (
      <>
        <small class="credit">
          <a href={content.hero.creditUrl || undefined}>{content.hero.credit}</a>
        </small>
      </>
    ) : null}
  </header>

  <section class="summit-intro container">
    <p class="archive-notice">
      {page.archiveNotice} {content.dates}
    </p>
    <h2>{content.introTitle}</h2>
    <div class="rich-text">
      <Fragment set:html={content.introHtml} />
    </div>
  </section>

  <section
    class="success"
    aria-label="Summit highlights"
    style={{
      'background-image': content.statisticsImage
        ? `linear-gradient(#0009, #0009), url('${content.statisticsImage}')`
        : undefined,
    }}
  >
    <blockquote>
      <div class="rich-text">
        <Fragment set:html={content.quoteHtml} />
      </div>
      {content.attribution ? (
        <>
          <footer>
            {content.attributionUrl ? (
              <>
                <a href={content.attributionUrl}>{content.attribution}</a>
              </>
            ) : (
              <>{content.attribution}</>
            )}
          </footer>
        </>
      ) : null}
    </blockquote>
    <dl class="statistics container">
      {content.statistics.map((statistic: any) => (
        <>
          <div>
            <dt>{statistic.label}</dt>
            <dd>{statistic.value}</dd>
          </div>
        </>
      ))}
    </dl>
    {content.videos.length ? (
      <>
        <div class:list={['videos container', { single: content.videos.length === 1 }]}>
          {content.videos.map((video: any) => (
            <>
              <iframe
                src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`}
                title={video.title}
                loading="lazy"
                allow="encrypted-media; picture-in-picture"
                allowfullscreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
            </>
          ))}
        </div>
      </>
    ) : null}
  </section>

  {keynote ? (
    <>
      <section class="keynotes container" aria-labelledby="keynotes-title">
        <h2 id="keynotes-title">Keynote Highlights</h2>
        {content.keynotes.map((item: any, index: number) => (
          <div
            class="selected-keynote"
            data-keynote-panel={index}
            hidden={index !== 0}
            aria-live="polite"
          >
            <img src={item.image} alt={item.title} loading="lazy" />
            <div>
              <h3>{item.title}</h3>
              <div class="rich-text" set:html={item.html} />
            </div>
          </div>
        ))}
        {[...new Set(content.keynotes.map((item: any) => item.day))].map((day: any) => (
          <>
            <h3>{day.replace(/^Day/, 'Day ')}</h3>
            <div class="keynote-options">
              {content.keynotes.map((item: any, index: number) => (
                <>
                  {item.day === day ? (
                    <>
                      <button type="button" data-keynote={index} aria-pressed={index === 0}>
                        <img src={item.thumbnail || item.image} alt="" loading="lazy" />
                        <span>{item.title}</span>
                      </button>
                    </>
                  ) : null}
                </>
              ))}
            </div>
          </>
        ))}
      </section>
    </>
  ) : null}

  {content.release.title ? (
    <>
      <section class="summit-release">
        <div class="container">
          <h2>{content.release.title}</h2>
          <div class="release-details">
            {content.release.image ? (
              <>
                <img src={content.release.image} alt="" loading="lazy" />
              </>
            ) : null}
            <div>
              <div class="rich-text">
                <Fragment set:html={content.release.html} />
              </div>
              {content.release.url ? (
                <>
                  <a class="highlight-button" href={content.release.url}>
                    {content.release.label}
                  </a>
                </>
              ) : null}
            </div>
          </div>
        </div>
      </section>
    </>
  ) : null}

  {content.photos.length ? (
    <>
      <section class="photos container" aria-labelledby="photos-title">
        <h2 id="photos-title">Oh, The Fun We Had!</h2>
        <div class="gallery">
          {content.photos.map((photo: any) => (
            <>
              <a
                href={photo.image}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${photo.title || 'Summit photo'} — open full image`}
              >
                <img src={photo.image} alt={photo.title} loading="lazy" />
              </a>
            </>
          ))}
        </div>
        {content.flickrUrl ? (
          <>
            <a href={content.flickrUrl}>
              See all of the pics from The Summit in {content.eventTitle} on Flickr
            </a>
          </>
        ) : null}
      </section>
    </>
  ) : null}

  {content.promotion.title ? (
    <>
      <section
        class="promotion"
        style={{
          'background-image': `linear-gradient(#0005, #0005), url('${content.promotion.image}')`,
        }}
      >
        <p>Historical Summit promotion</p>
        <h2>{content.promotion.title}</h2>
        <div class="rich-text">
          <Fragment set:html={content.promotion.html} />
        </div>
        {content.promotion.url ? (
          <>
            <a class="highlight-button" href={content.promotion.url}>
              {content.promotion.label}
            </a>
          </>
        ) : null}
        {content.promotion.credit ? (
          <>
            <small class="credit">
              <a href={content.promotion.creditUrl || undefined}>{content.promotion.credit}</a>
            </small>
          </>
        ) : null}
      </section>
    </>
  ) : null}
</main>

<style>
  .summit-highlights {
    color: #2a4e68;
    font-family: 'Open Sans', sans-serif;
    line-height: 1.6;
  }
  .container {
    width: min(1170px, calc(100% - 40px));
    margin-inline: auto;
  }
  h2 {
    color: inherit;
    font-size: 34px;
    font-weight: 300;
    line-height: 1.3;
    text-align: center;
  }
  a {
    color: #1678a5;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 3px solid #29abe2;
    outline-offset: 4px;
  }
  .summit-hero {
    position: relative;
    text-align: center;
    background-size: cover;
    background-position: center bottom;
  }
  .summit-logo {
    width: 150px;
    margin: 20px auto 30px;
  }
  .event-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  nav {
    gap: 0;
    font-size: 14px;
    text-transform: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    background: #225ba04d;
  }
  nav a {
    padding: 15px 25px;
    color: #b5e7ff;
    text-decoration: none;
    border-inline: 1px solid #71ccfe33;
  }
  nav a[aria-current] {
    background: white;
    color: #2a4e68;
    font-weight: 600;
  }
  .credit {
    display: block;
    padding: 8px;
    background: #0009;
    color: white;
  }
  .credit a {
    color: inherit;
  }
  .summit-intro {
    padding-block: 10px 20px;
    text-align: center;
  }
  .summit-intro h2 {
    margin: 30px 0 20px;
  }
  .archive-notice {
    font-size: 12px;
    color: #536b7c;
  }
  .success {
    background: #666;
    background-size: cover;
    background-position: center;
    color: white;
    padding: 80px 0;
  }
  blockquote {
    margin: 30px;
    font-size: 34px;
    font-weight: 300;
    line-height: 1.4;
    text-align: center;
  }
  blockquote footer {
    background: transparent;
    padding: 0;
    text-align: right;
    font-size: 28px;
    padding-right: 3%;
  }
  blockquote a {
    color: white;
  }
  .statistics {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    padding: 0;
    margin-block: 80px 40px;
  }
  .statistics div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    width: calc(25% - 20px);
  }
  .statistics dt {
    font-size: 19px;
    text-align: center;
  }
  .statistics dd {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    border: 4px solid #fa624d;
    border-radius: 50%;
    width: 138px;
    height: 138px;
    margin: 0 0 20px;
    font-size: 22px;
    font-weight: 700;
  }
  .statistics div:nth-child(4n + 2) dd {
    border-color: #2e729a;
  }
  .statistics div:nth-child(4n + 3) dd {
    border-color: #50dfd0;
  }
  .statistics div:nth-child(4n) dd {
    border-color: #ffe600;
  }
  .videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 50px 4%;
    padding-top: 40px;
  }
  iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .videos.single {
    grid-template-columns: minmax(0, 853px);
    justify-content: center;
  }
  .keynotes,
  .photos {
    padding-block: 40px 70px;
  }
  .selected-keynote {
    position: relative;
    background: #30739c;
  }
  .selected-keynote > img {
    width: 100%;
    max-height: 560px;
    object-fit: cover;
    display: block;
  }
  .selected-keynote > div {
    padding: 20px;
    color: white;
    background: #0009;
  }
  .keynote-options,
  .gallery {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 20px;
  }
  .keynote-options {
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  }
  button {
    font: inherit;
    text-align: left;
    background: white;
    border: 2px solid #ccd9e2;
    padding: 6px;
    cursor: pointer;
  }
  button[aria-pressed='true'] {
    border-color: #1678a5;
  }
  button img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }
  .summit-release {
    padding: 40px 0 90px;
    background: #edf2f7;
  }
  .release-details {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 40px;
    align-items: start;
  }
  .release-details img {
    max-width: 100%;
    margin: auto;
  }
  .highlight-button {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 30px;
    border-radius: 3px;
    background: #2a4e68;
    color: white;
    text-decoration: none;
  }
  .gallery {
    margin-bottom: 40px;
  }
  .gallery img {
    width: 100%;
    height: 114px;
    object-fit: cover;
  }
  .photos {
    text-align: center;
  }
  .promotion {
    position: relative;
    padding: 110px 20px;
    min-height: 400px;
    box-sizing: border-box;
    text-align: center;
    color: white;
    background-size: cover;
    background-position: left top;
  }
  .promotion h2 {
    font-size: 48px;
    margin: 25px 0;
  }
  .promotion .highlight-button {
    background: #da422f;
  }
  .promotion .credit {
    margin-top: 30px;
  }
  .rich-text :global(img) {
    max-width: 100%;
    height: auto;
  }
  @media (max-width: 700px) {
    h2 {
      font-size: 28px;
    }
    nav a {
      flex: 1 0 35%;
      padding: 12px;
    }
    .success {
      padding: 30px 0;
    }
    blockquote {
      margin: 20px;
      font-size: 25px;
    }
    blockquote footer {
      font-size: 20px;
    }
    .statistics {
      margin-block: 40px;
    }
    .statistics div {
      width: calc(50% - 20px);
    }
    .statistics dt {
      font-size: 15px;
    }
    .videos,
    .release-details {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .promotion {
      padding-block: 65px;
    }
    .promotion h2 {
      font-size: 34px;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-keynote]').forEach((button) =>
    button.addEventListener('click', () => {
      document
        .querySelectorAll<HTMLElement>('[data-keynote-panel]')
        .forEach((panel) => (panel.hidden = panel.dataset.keynotePanel !== button.dataset.keynote));
      document
        .querySelectorAll<HTMLButtonElement>('[data-keynote]')
        .forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    }),
  );
</script>
<style>
  [hidden] {
    display: none !important;
  }
</style>
