---
const { content } = Astro.props;
---

<main id="main" class="application-notice">
  <p class="eyebrow">Foundation review · Work remaining</p>
  <h1>{content.title}</h1>
  <p class="badge">{content.status}</p>
  <p>{content.introduction}</p>
  <div class="status-columns">
    <section>
      <h2>What we found</h2>
      <ul>
        {content.findings.map((text: string) => (
          <li>{text}</li>
        ))}
      </ul>
    </section>
    <section>
      <h2>Before this is ready</h2>
      <ul>
        {content.next.map((text: string) => (
          <li>{text}</li>
        ))}
      </ul>
    </section>
  </div>
  {content.related?.length > 0 && (
    <section aria-label="Available in this preview">
      <h2>Available in this preview</h2>
      <ul>
        {content.related.map((item: { href: string; label: string }) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  {content.production && content.link && (
    <p>
      <a href={content.production}>{content.link} ↗</a>
    </p>
  )}
  <p>
    <a href="/comparison/">Demo guide and implementation status</a>
  </p>
</main>
<style>
  .application-notice {
    max-width: 1100px;
    padding: 48px 24px 72px;
    margin: auto;
    line-height: 1.7;
    color: #294d68;
  }
  h1 {
    font-size: 40px;
    margin: 12px 0;
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12px;
    font-weight: bold;
  }
  .badge {
    display: inline-block;
    background: #fff3cc;
    padding: 6px 14px;
    color: #674f0b;
    border-radius: 4px;
  }
  .status-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    margin: 32px 0;
  }
  li {
    margin: 12px 0;
  }
  @media (max-width: 650px) {
    .status-columns {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
</style>
