---
const { content } = Astro.props;
const quotes = content.migrationStories;
---

{quotes.length > 0 && (
  <quote-carousel class="ai-quotes" aria-label={content.carousel.label}>
    <div class="quote-row">
      {quotes.length > 1 && (
        <button data-direction="-1" aria-label={content.carousel.previous}>
          ‹
        </button>
      )}
      <div aria-live="polite">
        {quotes.map((quote: { abstract: string; author: string }, i: number) => (
          <figure hidden={i !== 0}>
            <blockquote>{quote.abstract}</blockquote>
            <figcaption>{quote.author}</figcaption>
          </figure>
        ))}
      </div>
      {quotes.length > 1 && (
        <button data-direction="1" aria-label={content.carousel.next}>
          ›
        </button>
      )}
    </div>
    {quotes.length > 1 && (
      <div class="controls">
        <span>
          <b data-current>1</b> {content.carousel.of} {quotes.length}
        </span>
        <button
          data-play
          data-play-label={content.carousel.play}
          data-pause-label={content.carousel.pause}
        >
          {content.carousel.play}
        </button>
      </div>
    )}
  </quote-carousel>
)}
<script>
  class QuoteCarousel extends HTMLElement {
    connectedCallback() {
      const figures = [...this.querySelectorAll('figure')];
      const live = this.querySelector('[aria-live]');
      const play = this.querySelector<HTMLButtonElement>('[data-play]');
      let index = 0,
        rotating = false;
      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      const setPlaying = (value: boolean) => {
        rotating = value;
        if (play)
          play.textContent = (value ? play.dataset.pauseLabel : play.dataset.playLabel) || '';
        live?.setAttribute('aria-live', value ? 'off' : 'polite');
      };
      const move = (direction: number) => {
        figures[index].hidden = true;
        index = (index + direction + figures.length) % figures.length;
        figures[index].hidden = false;
        const count = this.querySelector('[data-current]');
        if (count) count.textContent = String(index + 1);
      };
      this.querySelectorAll<HTMLButtonElement>('[data-direction]').forEach((button) =>
        button.addEventListener('click', () => move(Number(button.dataset.direction))),
      );
      play?.addEventListener('click', () => setPlaying(!rotating));
      const respectMotion = () => {
        if (motion.matches) setPlaying(false);
      };
      motion.addEventListener('change', respectMotion);
      setPlaying(!motion.matches && figures.length > 1);
      const timer = window.setInterval(() => {
        if (
          rotating &&
          !document.hidden &&
          !this.matches(':hover') &&
          !this.contains(document.activeElement)
        )
          move(1);
      }, 5000);
      this.cleanup = () => {
        clearInterval(timer);
        motion.removeEventListener('change', respectMotion);
      };
    }
    cleanup?: () => void;
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  customElements.define('quote-carousel', QuoteCarousel);
</script>
<style>
  quote-carousel {
    display: block;
    background: #f7f7f7;
    color: #333;
    padding: 104px 24px 24px;
  }
  .quote-row {
    max-width: 1232px;
    display: flex;
    align-items: center;
    margin: auto;
    gap: 20px;
  }
  .quote-row > div {
    flex: 1;
  }
  figure {
    margin: 0;
    text-align: center;
  }
  figure[hidden] {
    display: none;
  }
  blockquote {
    font-size: 30px;
    line-height: 40px;
    font-weight: 300;
    color: #2a4e68;
    padding: 0 44px;
    margin: 0;
  }
  figcaption {
    margin-top: 32px;
    font-size: 17.6px;
    line-height: 20.8px;
    font-weight: 500;
  }
  button {
    border: 0;
    background: transparent;
    cursor: pointer;
    color: #004976;
  }
  button:focus-visible {
    outline: 3px solid #ed1944;
  }
  .quote-row button {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: #edf2f7;
    font-size: 28px;
  }
  .controls {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-top: 64px;
    font-size: 13px;
  }
  @media (max-width: 790px) {
    blockquote {
      font-size: 16px;
      line-height: 24px;
      padding: 0 16px;
    }
    .quote-row {
      gap: 8px;
    }
  }
</style>
