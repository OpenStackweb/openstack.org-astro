---
const { content } = Astro.props;
---

{content?.display && (
  <>
    <section class="newsletter-signup" aria-labelledby="newsletter-heading">
      <div class="newsletter-content">
        <h2 id="newsletter-heading">{content.title}</h2>
        <p>{content.description}</p>
        <a class="subscribe" href="https://signup.e2ma.net/signup/1900249/1771360/">
          {content.submitLabel}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </>
)}

<style>
  .newsletter-signup {
    background: #ed1944;
    color: white;
    padding: 50px 24px;
    text-align: center;
  }
  .newsletter-content {
    max-width: 1160px;
    margin: auto;
  }
  h2 {
    color: inherit;
    font-size: 24px;
    line-height: 1.3;
    font-weight: 400;
    margin: 10px 0;
  }
  p {
    color: inherit;
    font-size: 14px;
    margin: 0 0 30px;
  }
  .subscribe {
    display: inline-block;
    border: 2px solid white;
    border-radius: 4px;
    background: transparent;
    color: white;
    font-size: 14px;
    padding: 12px 30px;
  }
  .subscribe:hover {
    background: white;
    color: #b81034;
    text-decoration: none;
  }
  .subscribe:focus-visible {
    outline: 3px solid white;
    outline-offset: 4px;
  }
</style>
