---
import { newsletterSignupUrl } from '../lib/newsletter';

const { content } = Astro.props;
---

<section id="industry-newsletter" aria-labelledby="industry-newsletter-title">
  <h2 id="industry-newsletter-title">{content.title}</h2>
  <p>{content.description}</p>
  <a class="subscribe" href={newsletterSignupUrl}>
    {content.buttonLabel}
  </a>
</section>

<style>
  section {
    margin-top: 3rem;
    padding: 1.5rem;
    background: #f1f6f8;
    scroll-margin-top: 2rem;
  }
  h2 {
    margin-top: 0;
  }
  .subscribe {
    display: inline-block;
    padding: 0.75rem 1.25rem;
    border-radius: 0.2rem;
    color: white;
    background: #005481;
    font: inherit;
    text-decoration: none;
  }
  .subscribe:hover {
    background: #003e60;
    text-decoration: underline;
  }
  .subscribe:focus-visible {
    outline: 3px solid #005481;
    outline-offset: 4px;
  }
</style>
