---
import navigation from '../lib/content/navbar.json';
import { softwareNavigation } from '../lib/software/navigation.mjs';
const { release, catalog = [], path = Astro.url.pathname } = Astro.props;
type NavLink = { href: string; title: string; active: boolean; children: NavLink[] };
const links: NavLink[] = softwareNavigation(navigation, {
  path,
  release,
  catalog,
}).filter((item: NavLink) => new URL(item.href, Astro.url).pathname.startsWith('/software'));
// Announcements belong to Overview even before a new release is promoted in navigation.
const overview = links.find((item) => item.href.split('?')[0].replace(/\/$/, '') === '/software');
const section =
  links.find(
    (item) => item.children.length && (item.active || item.children.some((child) => child.active)),
  ) || (/^\/software\/openstack-[a-z0-9-]+\/?$/.test(path) ? overview : undefined);
---

<section class="software-heading" aria-label="Software section">
  <div class="heading-content">
    <slot name="heading">
      <p class="section-title">Software</p>
    </slot>
    <nav aria-label="Software navigation">
      {links.map((item) => (
        <a
          href={item.href}
          class:list={{ 'active-section': item === section || item.active }}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.title}
        </a>
      ))}
    </nav>
  </div>
  {section && (
    <div class="section-links-surface">
      <nav class="section-links" aria-label={`${section.title} navigation`}>
        {section.children.map((child) => (
          <a href={child.href} aria-current={child.active ? 'page' : undefined}>
            {child.title}
          </a>
        ))}
      </nav>
    </div>
  )}
</section>
<style>
  .heading-content,
  .section-links {
    max-width: 1160px;
    margin: auto;
    padding: 0 24px;
    display: flow-root;
  }
  .software-heading p {
    text-align: center;
    color: #2a4e68;
    font-size: 34px;
    line-height: 1.167;
    font-weight: 300;
    margin: 40px 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    padding-bottom: 0;
  }
  nav > a {
    padding: 15px 25px;
    border-top: 2px solid transparent;
  }
  nav > a.active-section {
    border-top-color: #29a9df;
    background: #edf2f7;
  }
  .section-links-surface {
    background: #edf2f7;
  }
  .section-links {
    display: flex;
    padding: 16px 24px;
    gap: 12px 36px;
  }
  .section-links a {
    text-transform: none;
    font-size: 14px;
    line-height: 21px;
    padding: 0 0 5px;
  }
  .section-links a[aria-current='page'] {
    border-bottom: 3px solid #2a5670;
    font-weight: 700;
  }
  a:focus-visible {
    outline: 3px solid #007ac2;
    outline-offset: 3px;
  }
  a {
    font-size: 12px;
    line-height: 1.42857;
    color: #2a4e68;
    text-transform: uppercase;
  }
</style>
