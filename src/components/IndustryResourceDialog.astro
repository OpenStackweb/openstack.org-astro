---
const { enabled = false } = Astro.props;
---
{enabled ? <industry-resource-dialog><slot /></industry-resource-dialog> : <slot />}

<script>
  class IndustryResourceDialog extends HTMLElement {
    private dialog?: HTMLDialogElement;
    private onClick = (event: MouseEvent) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest('a') : null;
      const section = this.querySelector('section');
      if (!link || !section || this.contains(link) || link.getAttribute('href') !== `#${section.id}`) return;
      event.preventDefault();
      this.dialog?.showModal();
    };
    connectedCallback() {
      if (this.dialog) {
        document.addEventListener('click', this.onClick);
        return;
      }
      const section = this.querySelector('section');
      if (!section || typeof HTMLDialogElement.prototype.showModal !== 'function') return;
      const dialog = document.createElement('dialog');
      const title = section.querySelector('h2, h3, h4');
      if (title) {
        title.id ||= `${section.id}-heading`;
        dialog.setAttribute('aria-labelledby', title.id);
      } else dialog.setAttribute('aria-label', 'Booklet resources');
      const form = document.createElement('form');
      form.method = 'dialog';
      const close = document.createElement('button');
      close.textContent = 'Close';
      close.setAttribute('aria-label', 'Close booklet dialog');
      form.appendChild(close);
      dialog.appendChild(form);
      dialog.appendChild(section);
      this.appendChild(dialog);
      this.dialog = dialog;
      document.addEventListener('click', this.onClick);
      if (location.hash === `#${section.id}`) dialog.showModal();
    }
    disconnectedCallback() {
      document.removeEventListener('click', this.onClick);
    }
  }
  if (!customElements.get('industry-resource-dialog')) customElements.define('industry-resource-dialog', IndustryResourceDialog);
</script>

<style is:global>
  industry-resource-dialog { display: contents; }
  industry-resource-dialog dialog {
    box-sizing: border-box;
    width: min(600px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    padding: 24px;
    border: 1px solid #8297a5;
    border-radius: 5px;
    color: #2a4e68;
  }
  industry-resource-dialog dialog::backdrop { background: #0009; }
  industry-resource-dialog dialog > form { display: flex; justify-content: end; margin-bottom: 12px; }
  industry-resource-dialog dialog button {
    padding: 8px 12px; background: white; color: inherit;
    border: 1px solid #647987; cursor: pointer;
  }
  industry-resource-dialog dialog[open] .content-section { padding: 0; }
  industry-resource-dialog dialog[open] .content-width { width: 100%; padding: 0; }
  industry-resource-dialog dialog[open] .landing-row { margin: 0; }
  industry-resource-dialog dialog :is(h2, h3, h4) { font-size: 24px; font-weight: 400; margin: 0 0 24px; }
  industry-resource-dialog dialog[open] .rich-text { text-align: left; }
  industry-resource-dialog dialog[open] .rich-text ul { display: block; padding-left: 24px; }
  industry-resource-dialog dialog[open] .rich-text a { display: inline-block; margin-block: 8px; }
  industry-resource-dialog dialog :is(a, button):focus-visible { outline: 3px solid #29abe2; outline-offset: 3px; }
</style>
