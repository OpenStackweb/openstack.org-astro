---
import IndustryNewsletter from './IndustryNewsletter.astro';
import IndustryIcon from './IndustryIcon.astro';
import ScienceBook from './ScienceBook.astro';
import IndustryDownload from './IndustryDownload.astro';
import IndustryResourceDialog from './IndustryResourceDialog.astro';
const { page } = Astro.props;
const content = page.industry;
const reportDownload = page.path === '/use-cases/telecoms-and-nfv/'
  ? content.sections.find((section: any) => section.id === 'downloadModal')
  : null;
---

<main
  id="main"
  class:list={[
    'industry-landing',
    {
      reports: content.layout === 'reports',
      'case-study': content.layout === 'case-study',
      appdev: page.path === '/appdev/',
      telecom: page.path === '/use-cases/telecoms-and-nfv/',
      enterprise: page.path === '/use-cases/enterprise/',
    },
  ]}
>
  {content.sectionLabel ? (
    <>
      <div class="section-label">
        <div class="content-width">
          {content.parentUrl ? (
            <>
              <a href={content.parentUrl}>{content.sectionLabel}</a>
            </>
          ) : (
            <>{content.sectionLabel}</>
          )}
        </div>
      </div>
    </>
  ) : null}
  <section class:list={['industry-banner', { 'text-overlay': content.heroOverlay }]} aria-labelledby="industry-title">
    <img class="banner-image" src={page.hero.image} alt="" fetchpriority="high" />
    <div
      class:list={[
        'content-width banner-copy',
        {
          balanced: content.heroLayout === 'balanced',
          centered: content.heroLayout === 'centered',
          resources: content.heroLayout === 'resources',
        },
      ]}
    >
      <div>
        {content.heroEyebrow && <div class="hero-eyebrow">{content.heroEyebrow}</div>}
        <h1 id="industry-title">{page.title}</h1>
        <p>{page.hero.subtitle}</p>
        {content.heroHtml && content.heroLayout !== 'resources' ? (
          <>
            <div class="hero-rich-text">
              <Fragment set:html={content.heroHtml} />
            </div>
          </>
        ) : null}
        {(content.layout === 'reports' || content.heroLayout === 'centered') && content.heroActionUrl ? (
          <>
            <a class="resource-button report-action" href={content.heroActionUrl}>
              {content.heroActionLabel}
            </a>
          </>
        ) : null}
      </div>
      {content.heroHtml && content.heroLayout === 'resources' && (
        <aside class="hero-resources" aria-label="Featured whitepapers">
          <Fragment set:html={content.heroHtml} />
        </aside>
      )}
      {content.heroActionUrl && content.layout !== 'reports' && content.heroLayout !== 'centered' ? (
        <>
          <aside aria-label="Featured resource">
            <p>{content.heroNote}</p>
            <a class="resource-button" href={content.heroActionUrl}>
              {content.heroActionLabel}
            </a>
          </aside>
        </>
      ) : null}
    </div>
    {content.photoCreditUrl ? (
      <>
        <a class="photo-credit" href={content.photoCreditUrl}>
          Photo credit
        </a>
      </>
    ) : null}
    {content.showBannerLinks && content.sectionLabel && content.heroLayout !== 'centered' ? (
      <>
        <div class="banner-links">
          <div class="content-width">
            <a href={content.parentUrl || '/user-stories/'}>
              ‹ {content.parentLabel || 'User Stories'}
            </a>
            {content.facts.length ? (
              <>
                <ul class="case-facts">
                  {content.facts.map((fact: any) => (
                    <>
                      <li>{fact}</li>
                    </>
                  ))}
                </ul>
              </>
            ) : (
              <>
                <span>{content.sectionLabel}</span>
              </>
            )}
          </div>
        </div>
      </>
    ) : null}
  </section>

  {content.sections.filter((section: any) => section !== reportDownload).map((section: any) => (
    <>
      <IndustryResourceDialog enabled={page.path === '/use-cases/enterprise/' && ['BookletModalHero', 'businessPersepctivesModal', 'PathToCloudModal'].includes(section.id)}>
      <section
        id={section.id}
        style={section.backgroundImage ? `background-image: url('${section.backgroundImage}')` : undefined}
        aria-labelledby={section.title ? `${section.id}-title` : undefined}
        class:list={[
          'content-section',
          {
            muted: section.tone === 'muted',
            blue: section.tone === 'blue',
            gray: section.tone === 'gray',
            sky: section.tone === 'sky',
            ocean: section.tone === 'ocean',
            dark: section.tone === 'dark',
            'split-section': section.kind === 'split',
            'title-only': section.kind === 'prose' && !section.html,
            quotation: section.kind === 'quote',
          },
        ]}
      >
        <div
          class:list={[
            'content-width',
            { 'reading-width': section.kind === 'prose' && Boolean(section.html) },
          ]}
        >
          {section.image && section.kind !== 'diagram' ? (
            <>
              <img
                class="section-image"
                src={section.image}
                alt={section.imageAlt}
                loading="lazy"
              />
            </>
          ) : null}
          {section.eyebrow && <p class="section-eyebrow">{section.eyebrow}</p>}
          {section.title ? (
            <>
              <h2 id={`${section.id}-title`}>{section.title}</h2>
            </>
          ) : null}
          {section.html ? (
            <>
              <div class="rich-text">
                <Fragment set:html={section.html} />
              </div>
            </>
          ) : null}
          {section.kind === 'rows' &&
            section.rows.map((row: any) => (
              <div class:list={['landing-row', { 'content-action': row.layout === 'content-action' }]} style={`--columns: ${Math.min(row.blocks.length, 5)}`}>
                {row.blocks.map((block: any) => (
                  <div class:list={['landing-block rich-text', { 'action-block': Boolean(block.actionUrl) }]}>
                    {block.icon && <IndustryIcon name={block.icon} />}
                    <Fragment set:html={block.html} />
                    {block.actionUrl && <a class="resource-button" href={block.actionUrl}>{block.actionLabel}</a>}
                  </div>
                ))}
              </div>
            ))}
          {section.kind === 'diagram' ? (
            <>
              <picture class="diagram">
                {section.mobileImage ? (
                  <>
                    <source media="(max-width: 767px)" srcset={section.mobileImage} />
                  </>
                ) : null}
                <img src={section.image} alt={section.imageAlt} loading="lazy" />
              </picture>
            </>
          ) : (
            <>
              {section.kind === 'quote' ? (
                <>
                  {section.portrait ? (
                    <>
                      <img class="portrait" src={section.portrait} alt="" loading="lazy" />
                    </>
                  ) : null}
                  <p>{section.attribution}</p>
                </>
              ) : (
                <>
                  {section.kind === 'logos' ? (
                    <>
                      <div class="logos">
                        {section.cards.map((card: any) => (
                          <>
                            <img src={card.image} alt={card.title} loading="lazy" />
                          </>
                        ))}
                      </div>
                    </>
                  ) : (
                    <>
                      {section.kind === 'split' ? (
                        <>
                          <div
                            class:list={[
                              'split-columns',
                              { 'image-left': section.imageSide === 'left' },
                            ]}
                          >
                            {section.cards.map((card: any) => (
                              <>
                                <article>
                                  {card.icon ? (
                                    <>
                                      <IndustryIcon name={card.icon} />
                                    </>
                                  ) : null}
                                  {card.image && card.url ? (
                                    <>
                                      <a
                                        class="diagram-link"
                                        href={card.url}
                                        aria-label={`Open full-size diagram: ${card.title}`}
                                      >
                                        <img
                                          class="split-image"
                                          src={card.image}
                                          alt={card.title}
                                          loading="lazy"
                                        />
                                      </a>
                                    </>
                                  ) : (
                                    <>
                                      {card.image ? (
                                        <>
                                          <img
                                            class="split-image"
                                            src={card.image}
                                            alt={card.title}
                                            loading="lazy"
                                          />
                                        </>
                                      ) : (
                                        <>
                                          {card.title ? (
                                            <>
                                              <h3>{card.title}</h3>
                                            </>
                                          ) : null}
                                        </>
                                      )}
                                    </>
                                  )}
                                  <div class="rich-text">
                                    <Fragment set:html={card.html} />
                                  </div>
                                </article>
                              </>
                            ))}
                          </div>
                        </>
                      ) : (
                        <>
                          {section.kind === 'cards' ? (
                            <>
                              <div
                                class:list={['benefits', { panels: section.cardStyle === 'panel' }]}
                              >
                                {section.cards.map((card: any) => (
                                  <>
                                    <article>
                                      {card.title ? (
                                        <>
                                          <h3>{card.url ? <a href={card.url}>{card.title}</a> : card.title}</h3>
                                        </>
                                      ) : null}
                                      {card.image ? (
                                        <>
                                          <img
                                            class="benefit-image"
                                            src={card.image}
                                            alt=""
                                            loading="lazy"
                                          />
                                        </>
                                      ) : (
                                        <>
                                          {card.icon ? (
                                            <>
                                              <IndustryIcon name={card.icon} />
                                            </>
                                          ) : null}
                                        </>
                                      )}
                                      <div class="rich-text">
                                        <Fragment set:html={card.html} />
                                      </div>
                                    </article>
                                  </>
                                ))}
                              </div>
                            </>
                          ) : (
                            <>
                              {section.kind === 'stories' ? (
                                <>
                                  <div class="stories" style={{ '--columns': section.columns }}>
                                    {section.cards.map((card: any) => (
                                      <>
                                        <article>
                                          <a href={card.url}>
                                            <img src={card.image} alt="" loading="lazy" />
                                            <h3>{card.title}</h3>
                                          </a>
                                          {card.html ? (
                                            <>
                                              <div class="rich-text">
                                                <Fragment set:html={card.html} />
                                              </div>
                                            </>
                                          ) : null}
                                        </article>
                                      </>
                                    ))}
                                  </div>
                                </>
                              ) : (
                                <>
                                  {section.kind === 'topics' ? (
                                    <>
                                      <ul class="topics">
                                        {section.items.map((item: any) => (
                                          <>
                                            <li>
                                              <span aria-hidden="true">✓</span>
                                              {item}
                                            </li>
                                          </>
                                        ))}
                                      </ul>
                                      {section.actionUrl ? (
                                        <>
                                          <a class="resource-button" href={section.actionUrl}>
                                            {section.actionLabel}
                                          </a>
                                        </>
                                      ) : null}
                                    </>
                                  ) : null}
                                </>
                              )}
                            </>
                          )}
                        </>
                      )}
                    </>
                  )}
                </>
              )}
            </>
          )}
        </div>
      </section>
      </IndustryResourceDialog>
    </>
  ))}
  {page.scienceBook ? (
    <>
      <div class="content-width">
        <ScienceBook content={page.scienceBook} />
      </div>
    </>
  ) : null}
  {reportDownload ? (
    <IndustryDownload content={reportDownload} newsletter={page.newsletter} />
  ) : page.newsletter ? (
    <>
      <div class="content-width">
        <IndustryNewsletter content={page.newsletter} />
      </div>
    </>
  ) : null}
</main>

<style>
  .industry-landing {
    color: #333;
    font-family: 'Open Sans', sans-serif;
    line-height: 1.5;
    font-size: 15px;
  }
  .content-width {
    width: min(1170px, calc(100% - 40px));
    margin-inline: auto;
  }
  .reading-width {
    max-width: 975px;
  }
  .section-label {
    background: #2a4e68;
    color: white;
    padding: 14px 0;
    text-transform: uppercase;
    font-size: 14px;
  }
  .section-label a {
    color: inherit;
    text-decoration: none;
  }
  .case-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
    color: #b7daee;
  }
  .diagram img {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .case-study .banner-copy {
    padding-block: 70px 100px;
  }
  .case-study aside {
    margin-top: 10px;
    padding: 30px;
  }
  .case-study aside p {
    font-style: normal;
    font-weight: 300;
  }
  .case-study aside .resource-button {
    display: block;
  }
  .case-study #customer-challenge > div > .rich-text {
    color: #75818a;
    font-size: 21px;
    font-weight: 300;
    line-height: 1.3;
    text-align: left;
    margin-bottom: 60px;
  }
  .case-study .content-section {
    padding-block: 65px;
  }
  .case-study .benefits article {
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .case-study .benefit-image {
    order: -1;
    width: 100%;
    height: 180px;
    margin-bottom: 30px;
  }
  .case-study .benefits h3 {
    border-left: 3px solid #fa624d;
    padding-left: 12px;
    font-size: 28px;
    font-weight: 300;
  }
  .case-study .split-columns article:nth-child(2) {
    border: 0;
    padding: 0;
  }
  .case-study #openstack-components .benefits {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .case-study #openstack-components .benefit-image {
    width: 100px;
    height: 100px;
  }
  .case-study .split-image {
    max-width: 100%;
  }
  .case-study .stories {
    padding: 0;
    background: transparent;
  }
  .case-study .split-section .rich-text {
    text-align: left;
  }
  .case-study .rich-text :global(iframe) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .case-study .rich-text :global(h3) {
    color: #2a4e68;
    font-weight: 300;
  }
  .industry-banner {
    position: relative;
    isolation: isolate;
    color: white;
    background: #173b54;
  }
  .banner-image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .industry-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #08263c22;
  }
  .banner-copy {
    display: grid;
    grid-template-columns: 2fr 1fr;
    align-items: start;
    gap: 30px;
    padding-block: 70px 85px;
  }
  .text-overlay::before {
    background: linear-gradient(to bottom, transparent 60px, #0009 60px, #0009 calc(100% - 60px), transparent calc(100% - 60px));
  }
  .text-overlay .centered {
    padding-block: 95px 110px;
  }
  .hero-eyebrow {
    margin-bottom: 20px;
    font-size: 16px;
  }
  .hero-eyebrow::before,
  .hero-eyebrow::after {
    content: '';
    display: inline-block;
    width: 65px;
    margin: 0 10px 4px;
    border-top: 1px solid #ffffff88;
  }
  .centered .report-action {
    display: inline-block;
    margin-top: 28px;
    min-width: min(280px, 100%);
    box-sizing: border-box;
    background: #da422f;
    font-weight: 400;
  }
  h1 {
    color: white;
    font-size: 40px;
    font-weight: 300;
    line-height: 1.2;
    margin: 0 0 8px;
  }
  .banner-copy > div > p {
    font-size: 23px;
    line-height: 1.2;
    margin: 0;
    font-weight: 300;
  }
  aside {
    padding: 25px;
    background: #123d56d9;
    text-align: center;
  }
  aside p {
    margin: 0 0 14px;
    font-style: italic;
    font-size: 14px;
  }
  .resource-button {
    display: inline-block;
    background: #b82c16;
    color: white;
    padding: 12px 20px;
    text-decoration: none;
    font-weight: 700;
  }
  .photo-credit {
    position: absolute;
    right: 20px;
    bottom: 75px;
    color: white;
    font-size: 12px;
    background: #123d5688;
    padding: 2px 6px;
  }
  .banner-links {
    padding: 20px 0;
    background: #073751cc;
    border-top: 1px solid #fff4;
    text-transform: uppercase;
    font-size: 13px;
  }
  .banner-links > div {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .banner-links a {
    color: white;
    text-decoration: none;
  }
  .content-section {
    background-repeat: no-repeat;
    background-position: left top;
    padding: 60px 0;
    text-align: center;
  }
  /* Restore the legacy Edge overview without resizing other editorial images. */
  #use-cases-edge-computing-1 {
    background: #edf2f7;
    padding: 30px 0;
  }
  #use-cases-edge-computing-1 .landing-block :global(img) {
    width: auto;
    max-width: 157px;
    height: 152px;
    object-fit: contain;
    margin: 0 auto 15px;
  }
  #use-cases-edge-computing-3.gray {
    background: #edf2f7;
  }
  #use-cases-edge-computing-3 .landing-block {
    text-align: left;
  }
  #use-cases-edge-computing-4 {
    padding: 60px 0 40px;
  }
  #use-cases-edge-computing-4 .landing-row {
    margin: 0;
    align-items: center;
  }
  #use-cases-edge-computing-4 :global(h3) {
    color: white;
    font-size: 1.3em;
    text-align: right;
    margin: 10px 0;
  }
  #use-cases-edge-computing-4 :global(p) {
    border-left: 1px solid white;
    padding-left: 40px;
    text-align: left;
  }
  #use-cases-edge-computing-4 :global(a) {
    display: block;
    background: #31739c;
    padding: 15px 5%;
    color: white;
    text-decoration: none;
  }
  #use-cases-edge-computing-4 :global(a:hover),
  #use-cases-edge-computing-4 :global(a:focus-visible) {
    background: #20547d;
  }
  #use-cases-edge-computing-5 :global(h4) {
    display: flex;
    align-items: center;
    gap: 15px;
    color: #2a4e68;
    font-size: 20px;
    font-weight: 400;
    text-transform: uppercase;
  }
  #use-cases-edge-computing-5 :global(h4::before),
  #use-cases-edge-computing-5 :global(h4::after) {
    content: '';
    height: 1px;
    background: #ced9e5;
    flex: 1;
  }
  @media (max-width: 767px) {
    #use-cases-edge-computing-4 :global(h3) {
      text-align: center;
    }
    #use-cases-edge-computing-4 :global(p) {
      text-align: center;
      border-left: 0;
      padding-left: 0;
    }
  }
  .section-image {
    max-width: 200px;
    max-height: 150px;
    object-fit: contain;
    margin-bottom: 30px;
  }
  .portrait {
    width: 100px;
    height: 100px;
    object-fit: cover;
    border-radius: 50%;
    margin: 20px auto;
  }
  .quotation .rich-text {
    font-family: Georgia, serif;
    max-width: 720px;
    margin-inline: auto;
    font-size: 20px;
  }
  .benefit-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
    margin-bottom: 20px;
  }
  .logos {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
    gap: 40px;
    margin-block: 50px;
  }
  .logos img {
    width: 100%;
    max-height: 85px;
    object-fit: contain;
  }
  .balanced {
    grid-template-columns: 1fr 1fr;
    padding-block: 80px 95px;
  }
  .resources {
    grid-template-columns: 3fr 1fr;
    padding-block: 60px;
  }
  .resources h1 {
    font-size: 36px;
    margin-bottom: 20px;
  }
  .resources > div > p {
    font-size: 22px;
    line-height: 1.45;
  }
  .hero-resources {
    background: transparent;
    padding: 20px 0 0;
    font-size: 14px;
  }
  .hero-resources :global(strong) {
    display: block;
  }
  .hero-resources :global(a) {
    display: block;
    margin: 10px auto 20px;
    padding: 8px;
    color: white;
    background: #ec1944;
    text-decoration: none;
    font-size: 15px;
  }
  .hero-resources :global(a + strong)::before {
    content: '';
    display: block;
    width: 30%;
    margin: 0 auto 15px;
    border-top: 1px solid white;
  }
  .balanced h1 {
    font-size: 36px;
    margin-bottom: 20px;
  }
  .balanced > div > p {
    font-size: 22px;
  }
  .balanced aside {
    justify-self: end;
    width: min(100%, 360px);
    box-sizing: border-box;
  }
  .balanced aside p {
    font-style: normal;
    font-weight: 600;
  }
  .balanced .resource-button {
    display: block;
  }
  .gray {
    background: #f7f7f7;
  }
  .title-only h2 {
    font-size: 32px;
    margin-bottom: 0;
  }
  .quotation {
    padding-block: 90px;
  }
  .quotation .section-image {
    margin-bottom: 60px;
  }
  #use-cases-containers-1 .content-width {
    max-width: 960px;
  }
  #use-cases-containers-2 .section-image {
    margin-bottom: 0;
  }
  #use-cases-containers-2 .rich-text :global(blockquote) {
    position: relative;
    margin: 0 20px 35px;
    font-weight: 400;
    line-height: 1.4;
  }
  #use-cases-containers-2 .rich-text :global(blockquote)::before,
  #use-cases-containers-2 .rich-text :global(blockquote)::after {
    position: absolute;
    top: -25px;
    color: #d4dce5;
    font-size: 70px;
  }
  #use-cases-containers-2 .rich-text :global(blockquote)::before { content: '“'; left: -30px; }
  #use-cases-containers-2 .rich-text :global(blockquote)::after { content: '”'; right: -30px; }
  #use-cases-containers-2 .portrait {
    width: 130px;
    height: 130px;
    border: 4px solid #edf2f7;
    margin: 5px auto;
  }
  #use-cases-containers-2 .content-width > p {
    white-space: pre-line;
    font-family: Georgia, serif;
    margin: 0;
  }
  #use-cases-containers-3 .landing-block :global(h3) {
    font-size: 24px;
    font-weight: 400;
    color: #2a4e68;
  }
  #use-cases-containers-3 .landing-block :global(h4) {
    font-size: 18px;
    font-weight: 400;
    color: #2a4e68;
  }
  #use-cases-containers-3 .landing-block :global(svg) {
    width: 70px;
    height: 70px;
    color: #30739c;
