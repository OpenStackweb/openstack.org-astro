---
import NewsletterSignup from './NewsletterSignup.astro';
import originalContent from '../lib/content/footer.json';
import { footerMedia, validateFooterSubmission } from '../../tina/footer-validation.mjs';
import { renderEditorialBody } from '../lib/server/editorial.mjs';
const socialIcons: Record<string, string> = Object.fromEntries(
  ['facebook-square', 'linkedin', 'youtube-square', 'weixin'].map((name) => [
    name,
    `/images/footer/${name}.svg`,
  ]),
);
const content = validateFooterSubmission(Astro.props.content ?? originalContent);
import { reviewHref } from '../lib/legacy-routes.js';
---

<NewsletterSignup content={content.newsletter} />

<footer>
  <div class="footer-columns">
    {(content.columns ?? [])
      .filter((column: any) => column.display)
      .map((column: any) => (
        <>
          <section>
            <h3>{column.title}</h3>

            {(column.items ?? []).map((item: any) => (
              <>
                <a href={reviewHref(item.link)}>{item.title}</a>
              </>
            ))}
          </section>
        </>
      ))}

    {(content.social?.display || content.credit?.display) && (
      <section class="footer-community">
        {content.social?.display && (
          <>
            <h3>{content.social.title}</h3>
            <footer-social>
              {(content.social.networks ?? [])
                .filter((network: any) => network.display)
                .map((network: any, index: number) => {
                  const modal = footerMedia(network.clickBehaviour?.openModal);
                  const icon =
                    footerMedia(network.rendering?.file) || socialIcons[network.rendering?.icon];
                  const attrs = Object.fromEntries(
                    (network.clickBehaviour?.attributes ?? []).map((attribute: any) => [
                      attribute.attribute,
                      attribute.value,
                    ]),
                  );
                  const rel =
                    [attrs.rel, attrs.target === '_blank' ? 'noopener noreferrer' : '']
                      .filter(Boolean)
                      .join(' ') || undefined;
                  return modal ? (
                    <>
                      <button
                        type="button"
                        class="social-action"
                        data-social-open={`footer-social-${index}`}
                        aria-haspopup="dialog"
                      >
                        {icon && <img class="network-icon" src={icon} alt="" />}{' '}
                        <span class:list={{ 'icon-label': !!icon }}>{network.title}</span>
                      </button>
                      <dialog id={`footer-social-${index}`} aria-label={`${network.title} QR code`}>
                        <form method="dialog">
                          <button class="dialog-close" aria-label="Close QR code">
                            Close ×
                          </button>
                        </form>
                        <img
                          src={modal}
                          alt={`Scan this QR code to find OpenStack on ${network.title}`}
                          width="300"
                          height="300"
                          loading="lazy"
                        />
                      </dialog>
                    </>
                  ) : network.clickBehaviour?.link ? (
                    <a href={reviewHref(network.clickBehaviour.link)} {...attrs} rel={rel}>
                      {icon && <img class="network-icon" src={icon} alt="" />}{' '}
                      <span class:list={{ 'icon-label': !!icon }}>{network.title}</span>
                    </a>
                  ) : null;
                })}
            </footer-social>
          </>
        )}
        {content.credit?.display && (
          <div class="credits">
            <Fragment set:html={renderEditorialBody(content.credit.content || '', '/')} />
          </div>
        )}
      </section>
    )}
  </div>
  <p class="preview-note">
    Standalone beta · Unfinished sections show migration notices. External links open other
    websites.
  </p>
</footer>

<script>
  class FooterSocial extends HTMLElement {
    controller?: AbortController;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      this.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const button = target.closest<HTMLButtonElement>('[data-social-open]');
          if (button) {
            const dialog = document.getElementById(button.dataset.socialOpen!);
            if (dialog instanceof HTMLDialogElement && this.contains(dialog)) dialog.showModal();
          }
          if (target instanceof HTMLDialogElement) {
            const { left, right, top, bottom } = target.getBoundingClientRect();
            if (
              event.clientX < left ||
              event.clientX > right ||
              event.clientY < top ||
              event.clientY > bottom
            )
              target.close();
          }
        },
        { signal: this.controller.signal },
      );
    }
    disconnectedCallback() {
      this.controller?.abort();
    }
  }
  if (!customElements.get('footer-social')) customElements.define('footer-social', FooterSocial);
</script>
<style>
  footer-social {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  footer-social > a,
  footer-social > .social-action {
    display: inline-flex;
    align-items: center;
    margin: 0;
    min-height: 36px;
  }
  .icon-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .network-icon {
    width: 36px;
    height: 36px;
    object-fit: contain;
    vertical-align: middle;
    margin-right: 0;
  }
  .social-action {
    display: block;
    border: 0;
    padding: 0;
    margin: 0 0 8px;
    background: none;
    color: #aaa;
    font: inherit;
    font-size: 12px;
    line-height: 18px;
    cursor: pointer;
  }
  .social-action:hover {
    color: white;
    text-decoration: underline;
  }
  .social-action:focus-visible,
  .dialog-close:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
  dialog {
    border: 0;
    border-radius: 6px;
    padding: 18px;
    max-width: calc(100vw - 32px);
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 65%);
  }
  dialog img {
    display: block;
    width: 300px;
    max-width: 100%;
    height: auto;
  }
  dialog form {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 12px;
  }
  .dialog-close {
    border: 0;
    background: none;
    font: inherit;
    color: #243746;
    cursor: pointer;
  }

  footer {
    background: #333;
    color: #fff;
    padding: 70px 24px;
    font-family: 'Open Sans', Helvetica, Arial, sans-serif;
  }
  .footer-columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) minmax(0, 2fr);
    max-width: 1140px;
    margin: auto;
    gap: 30px;
  }
  h3 {
    color: #fff;
    font-size: 14px;
    font-weight: 400;
    line-height: 21px;
    margin: 14px 0;
  }
  section a {
    display: block;
    color: #aaa;
    font-size: 12px;
    line-height: 18px;
    margin-bottom: 3px;
    text-decoration: none;
  }
  footer :global(a:hover) {
    color: #fff;
    text-decoration: underline;
  }
  footer :global(a:focus-visible) {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  .credits,
  .preview-note {
    max-width: 1140px;
    margin: 30px auto 0;
    font-size: 12px;
    line-height: 18px;
  }
  .credits {
    color: #aaa;
  }
  .credits :global(a) {
    color: #aaa;
    text-decoration: underline;
  }
  .preview-note {
    color: #aaa;
    border-top: 1px solid #555;
    padding-top: 20px;
    margin-top: 20px;
  }
  @media (max-width: 1000px) {
    .footer-columns {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .footer-community {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 700px) {
    footer {
      padding: 40px 24px;
    }
    .footer-columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }
</style>
