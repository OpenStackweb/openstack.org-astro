---
import Site from '../layouts/Site.astro';
import rawContent from '../lib/content/use-cases.json';
import stories from '../lib/user-stories/catalog.json';
import { prepareUseCases } from '../lib/server/use-cases.mjs';
import { storyGroups, storySelection } from '../lib/user-stories/catalog.mjs';
import { reviewHref } from '../lib/legacy-routes.js';
import { renderEditorialBody } from '../lib/server/editorial.mjs';
const content = prepareUseCases(rawContent);
const groups = storyGroups(stories, storySelection());
---

<Site title={content.pageTitle} description={content.description} socialImage={content.socialImage}>
  <main class="use-cases">
    <header class="introduction">
      <h1>{content.title}</h1>
      <div set:html={content.headerHtml} />
    </header>
    <section class="cases-hero" aria-label={content.videoLabel} data-video-id={content.youtubeId}>
      <img src={content.heroImage} alt="" />
      <div class="cases-hero-copy">
        <div set:html={content.heroHtml} />
        <button data-play-video>{content.videoLabel} ▶</button>
      </div>
      <div data-video-player hidden>
        <button class="close-video">{content.closeVideoLabel}</button>
      </div>
    </section>
    <section class="catalogue" aria-label={content.catalogueLabel}>
      <div class="toolbar">
        <nav aria-label={content.viewsLabel}>
          {content.views.map((view: { value: string; label: string }) => (
            <button data-view={view.value} aria-pressed={view.value === 'date'}>
              {view.label}
            </button>
          ))}
        </nav>
        <form role="search" data-story-search>
          <label class="sr-only" for="story-search">
            {content.searchLabel}
          </label>
          <div class="search-fields">
            <input id="story-search" type="search" />
            <button type="submit" aria-label={content.searchButton}>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
                <circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="m15 15 5 5" stroke="currentColor" stroke-width="2" />
              </svg>
            </button>
          </div>
        </form>
        <div class="display-options" aria-label={content.displayLabel}>
          <button data-display="grid" aria-label={content.gridLabel} aria-pressed="true">
            <span aria-hidden="true">▦</span>
          </button>
          <button data-display="list" aria-label={content.listLabel} aria-pressed="false">
            <span aria-hidden="true">☷</span>
          </button>
        </div>
      </div>
      <p class="result-count" aria-live="polite">
        <span data-count data-label={content.resultsLabel}>
          {stories.length} {content.resultsLabel}
        </span>
        <button class="clear" hidden>
          {content.clearLabel}
        </button>
      </p>
      <p class="empty" hidden>
        {content.emptyLabel}
      </p>
      <div data-groups>
        {groups.map((group) => (
          <section class="story-group">
            <div class="story-cards">
              {group.stories.map((story: (typeof stories)[number]) => (
                <article
                  data-story={JSON.stringify({
                    id: story.id,
                    name: story.name,
                    description: story.description,
                    date: story.date,
                    industry: story.industry,
                    location: story.location,
                    largeScale: story.largeScale,
                    tags: story.tags,
                  })}
                >
                  <a
                    class="story-image"
                    href={reviewHref(story.link)}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={story.image || '/images/openstack-logo.svg'}
                      class:list={{ 'image-placeholder': !story.image }}
                      alt=""
                      loading="lazy"
                    />
                  </a>
                  <div class="story-copy">
                    <h3>
                      <a href={reviewHref(story.link)}>{story.name}</a>
                    </h3>
                    <div
                      class="summary"
                      set:html={renderEditorialBody(story.shortDescription, '/use-cases/')}
                    />
                    <details>
                      <summary>{content.detailsLabel}</summary>
                      <div set:html={renderEditorialBody(story.description, '/use-cases/')} />
                    </details>
                    <div class="tags">
                      {story.tags.map((tag: string) => (
                        <button data-tag={tag}>{tag}</button>
                      ))}
                    </div>
                    <a class="read-more" href={reviewHref(story.link)}>
                      {content.readMoreLabel} → <span class="sr-only">{story.name}</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
    <section class="survey">
      <p>{content.surveyText}</p>
      <a href={content.surveyUrl}>{content.surveyLabel} →</a>
    </section>
  </main>
</Site>
<script>
  import '../lib/user-stories/browser';
</script>
<style is:global>
  @scope (.use-cases) {
    :scope {
      color: #333;
      max-width: 1170px;
      margin: auto;
      padding: 40px 15px 64px;
      font-size: 14px;
      line-height: 20px;
    }
    .introduction {
      max-width: 970px;
      margin: 0 auto 40px;
      text-align: center;
      border: 0;
    }
    h1 {
      color: #2a4e68;
      font-size: 34px;
      line-height: 1.1;
      font-weight: 300;
      margin: 0 0 15px;
    }
    .introduction :is(p) {
      color: #999;
      font-size: 14px;
      line-height: 20px;
      margin: 0 0 10px;
    }
    .introduction :is(a) {
      color: #30739c;
      border: 0;
      text-decoration: none;
    }
    .cases-hero {
      position: relative;
      min-height: 380px;
      padding: 70px 0;
      background: #172b3b;
      color: white;
    }
    .cases-hero > img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .cases-hero-copy {
      position: relative;
      width: 100%;
      padding: 50px 110px;
      background: rgb(0 0 0 / 80%);
      text-align: left;
    }
    .cases-hero-copy :is(h3) {
      color: white;
      font-size: 30.8px;
      font-weight: 400;
      line-height: 1.1;
      margin: 0 0 30px;
    }
    .cases-hero button {
      border: 1px solid white;
      padding: 15px 30px;
      color: white;
      background: transparent;
      text-transform: uppercase;
      font-size: 12.6px;
    }
    .cases-hero button:hover {
      background: rgb(255 255 255 / 20%);
    }
    iframe {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      border: 0;
    }
    .close-video {
      position: relative;
      margin: 12px;
    }
    .catalogue {
      padding-top: 60px;
    }
    .toolbar,
    .toolbar nav,
    .display-options,
    .search-fields {
      display: flex;
      align-items: center;
    }
    .toolbar {
      gap: 24px;
      border-bottom: 1px solid #d3d3d3;
    }
    .toolbar nav {
      flex: 1;
      gap: 0;
      flex-wrap: wrap;
    }
    .toolbar nav button {
      border: 0;
      border-bottom: 3px solid transparent;
      padding: 8px 22px 16px;
      text-transform: uppercase;
      color: #808080;
    }
    .toolbar nav button[aria-pressed='true'] {
      border-bottom-color: #da422f;
      color: #000;
      font-weight: 700;
    }
    .search-fields {
      border: 1px solid #d3d3d3;
      border-radius: 20px;
      overflow: hidden;
    }
    input {
      width: 215px;
      min-width: 0;
      border: 0;
      padding: 5px 15px;
      height: 30px;
      color: #333;
      font: inherit;
    }
    .search-fields button {
      border: 0;
      padding: 5px 12px;
      color: #999;
    }
    button {
      font: inherit;
      border: 1px solid #b9ccd8;
      background: white;
      color: #30739c;
      padding: 6px 10px;
      cursor: pointer;
    }
    .display-options button {
      border: 0;
      font-size: 24px;
      padding: 0 4px;
      color: #ccc;
    }
    .display-options button[aria-pressed='true'] {
      color: #000;
    }
    button:focus-visible,
    a:focus-visible,
    input:focus-visible,
    summary:focus-visible {
      outline: 3px solid #e60039;
      outline-offset: 3px;
    }
    .result-count {
      font-size: 12px;
      color: #777;
      margin: 14px 0 30px;
    }
    .clear {
      margin-left: 12px;
    }
    .story-group {
      scroll-margin-top: 24px;
    }
    .story-cards {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 30px;
    }
    article {
      position: relative;
      min-height: 300px;
      min-width: 0;
      background: #333;
      overflow-wrap: anywhere;
    }
    .story-image {
      display: block;
      height: 300px;
    }
    .story-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .story-image .image-placeholder {
      object-fit: contain;
      padding: 32px;
      box-sizing: border-box;
      background: #ecf1f4;
    }
    .story-copy {
      position: absolute;
      bottom: 15px;
      left: 15px;
      right: 15px;
      padding: 10px;
      background: white;
      line-height: 1.4;
    }
    h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 600;
    }
    h3 a {
      color: inherit;
      text-decoration: none;
    }
    .summary {
      font-size: 12.6px;
    }
    .summary :is(p) {
      margin: 0;
    }
    a {
      color: #30739c;
    }
    details {
      margin: 14px 0;
    }
    summary {
      cursor: pointer;
    }
    .tags {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
      margin-top: 6px;
    }
    .tags button {
      border-color: #999;
      border-radius: 10px;
      color: #777;
      font-size: 10px;
      padding: 0 5px;
      background: transparent;
    }
    .read-more {
      display: inline-block;
      border: 1px solid currentColor;
      padding: 8px 20px;
      margin-top: 10px;
      text-transform: uppercase;
    }
    .story-cards:not(.cases-list) details,
    .story-cards:not(.cases-list) .read-more {
      display: none;
    }
    .story-cards:not(.cases-list) article:is(:hover, :focus-within) .story-copy {
      inset: 0;
      overflow: auto;
      background: rgb(0 0 0 / 80%);
      color: white;
      padding: 15px;
    }
    .story-cards:not(.cases-list) article:is(:hover, :focus-within) :is(details, .read-more) {
      display: block;
    }
    .story-cards:not(.cases-list) article:is(:hover, :focus-within) :is(a, button) {
      color: white;
    }
    .cases-list {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .cases-list article {
      display: grid;
      grid-template-columns: 50px minmax(0, 1fr);
      gap: 20px;
      background: white;
      min-height: 0;
    }
    .cases-list .story-image {
      height: 50px;
    }
    .cases-list .story-copy {
      position: static;
      padding: 0;
    }
    .cases-list details {
      margin: 8px 0;
    }
    .survey {
      margin: 40px 0 30px;
      text-align: center;
      padding: 40px 0;
      border-top: 1px solid #edf2f7;
    }
    .survey p {
      display: inline;
    }
    .survey a {
      display: inline-block;
      background: #da422f;
      color: white;
      padding: 4px 10px;
      margin-left: 20px;
      font-size: 12px;
      text-transform: uppercase;
    }
    .empty {
      padding: 30px;
      background: #eef4f7;
    }
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    @media (max-width: 1100px) {
      .toolbar {
        flex-wrap: wrap;
        padding-bottom: 10px;
        gap: 12px;
      }
      .toolbar nav {
        flex-basis: 100%;
      }
    }
    @media (max-width: 900px) {
      .story-cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .cases-list {
        grid-template-columns: 1fr;
      }
      .cases-hero-copy {
        padding: 40px;
      }
    }
    @media (max-width: 600px) {
      :scope {
        padding: 30px 16px;
      }
      h1 {
        font-size: 30px;
      }
      .cases-hero {
        padding: 50px 0;
        min-height: 280px;
      }
      .cases-hero-copy {
        padding: 20px;
      }
      .cases-hero-copy :is(h3) {
        font-size: 22.4px;
      }
      .story-cards {
        grid-template-columns: 1fr;
      }
      .toolbar nav button {
        padding: 8px 10px;
      }
      .search-fields {
        max-width: 100%;
      }
      input {
        width: 180px;
      }
      .survey p {
        display: block;
      }
      .survey a {
        margin: 10px 0 0;
      }
    }

    [hidden] {
      display: none !important;
    }
  }
</style>
