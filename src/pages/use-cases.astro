---
import Site from '../layouts/Site.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import UseCases from '../components/tina/UseCases.astro';
import { loadUseCases } from '../lib/tina/use-cases';
const result = await loadUseCases();
const content = result.data.useCases;
---
<Site title={content.pageTitle} description={content.description} socialImage={content.socialImage}>
  <TinaIsland name="use-cases" wrapper={{ tag: 'div' }} primary>
    <UseCases content={content} />
  </TinaIsland>
</Site>
