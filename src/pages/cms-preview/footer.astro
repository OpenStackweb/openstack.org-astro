---
import Layout from '../../layouts/Site.astro';
---

<Layout
  title="Shared footer preview | OpenStack"
  footerEditorPrimary
  canonicalUrl="https://www.openstack.org/"
  comparisonPath="/"
  showAnnouncement={false}
>
  <main id="main" class="footer-preview">
    <h1>Shared footer preview</h1>
    <p>
      Changes to this footer apply across the website. Review the newsletter promotion, link
      columns, social actions and credits below.
    </p>
  </main>
</Layout>
<style>
  .footer-preview {
    max-width: 1140px;
    margin: 36px auto;
    padding: 0 24px;
  }
</style>
