---
import Layout from '../../layouts/Site.astro';
---

<Layout
  title="Shared navigation preview | OpenStack"
  navigationEditorPrimary
  showAnnouncement={false}
  canonicalUrl="https://www.openstack.org/"
  comparisonPath="/"
>
  <main id="main">
    <h1>Shared navigation preview</h1>
    <p>
      Edit the main labels, destinations and dropdown entries above. Changes apply across the
      website.
    </p>
    <p>
      Join, search and login controls remain part of the site. Shared authentication is still
      pending.
    </p>
  </main>
</Layout>
<style>
  main {
    max-width: 1140px;
    margin: 48px auto;
    padding: 0 24px;
  }
</style>
