---
import Layout from '../../layouts/Site.astro';
import ApplicationNotice from '../../components/ApplicationNotice.astro';
import { appStatus } from '../../lib/app-status.mjs';
const softwareNotice = Astro.url.searchParams.get('section') === 'software';
const tour = [
  ['/', 'Homepage', 'Shared navigation, branding and footer'],
  ['/use-cases/', 'Use Cases', '74 stories with search, sorting and grouped views'],
  ['/openstack-for-ai/', 'OpenStack for AI', 'Editorial content, media and quote carousel'],
  ['/vmware-migration-to-openstack/', 'VMware migration', 'Marketing page and research guide'],
  ['/community/', 'Community', 'Contribution choices and project resources'],
  [
    '/software/project-navigator/openstack-components/',
    'Software catalogue',
    'Existing React application inside Astro',
  ],
  [
    '/summit/boston-2017/',
    'Boston Summit archive',
    'Structured historical highlights, sponsors, FAQs and venues',
  ],
  ['/use-cases/science/', 'Science and HPC', 'Structured industry content and research'],
  [
    '/community/supporting-organizations/',
    'Supporting organizations',
    'Organizations and public profiles',
  ],
  ['/coa/', 'Certification', 'Exam information and training partners'],
  ['/appdev/', 'App developer resources', 'Editable guides, resource cards and selected videos'],
  ['/marketing/', 'Marketing resources', 'Editable event guidance and historical downloads'],
  ['/cms-proof/', 'Tina editor proof', 'Isolated Git editing and R2 media evaluation'],
];
---

<Layout title={softwareNotice ? 'Software migration status | OpenStack' : 'OpenStack Astro — demo guide and readiness | OpenStack'}>
  {softwareNotice ? <ApplicationNotice content={appStatus.software} /> : (
  <main id="main" class="status">
    <p class="eyebrow">Foundation review</p>
    <h1>OpenStack.org, built with Astro</h1>
    <p>
      The proposed website keeps content in Git, uses HTML-forward Astro templates, and integrates
      the existing React software application within one shared header and footer. This protected
      review site is independent of production and has no SilverStripe page proxy.
    </p>
    <h2>Suggested demo tour</h2>
    <div class="tour">
      {tour.map(([url, title, description]) => (
        <a href={url}>
          <h3>{title}</h3>
          <p>{description}</p>
          <span>Explore →</span>
        </a>
      ))}
    </div>
    <h2>What is working</h2>
    <p>
      The 213 imported editorial records now have native renderers, including specialized summit and
      industry templates. Community, learning, certification, company profiles, research readers,
      search, and the software catalogue have their own native routes. Research PDFs and approved
      images are served from private Cloudflare R2.
    </p>
    <p>
      <a href="/admin/index.html#/~">Tina edits the homepage</a>, shared announcement, navigation,
      footer, release announcements and 186 imported page records. App developer and marketing
      resources have editable sections and lists. Saving content commits it to Git and starts a
      checked deployment of this protected review site. Creating and publishing a new release
      announcement has been verified through the hosted editor; it does not change the Software
      service or automatically promote the release on the homepage.
    </p>
    <h2 id="authentication">What remains before production</h2>
    <ul>
      <li>
        <strong>Application sign-in:</strong> reviewer access works through Cloudflare Access.
        Visitor OpenInfraID login is enabled on this host and reaches the provider’s sign-in page.
        A complete sign-in, account lookup, refresh and logout still need end-to-end acceptance.
        Software and Marketplace service authentication remains a separate integration.
      </li>
      <li>
        <strong>Content editing:</strong> 27 rarely edited sponsor and location/venue archives are
        intentionally maintained directly in Git. Tina text, release and PNG media publishing have
        passed end-to-end checks. Paper editing and PDF regeneration, concurrent
        editing, remaining list controls, PDF upload checks and production publishing approvals
        still need work or verification. Available editor fields do not prove every workflow is complete.
      </li>
      <li>
        <strong>Software:</strong> the React catalogue works with the migrated development snapshot.
        Production service data, identity, permissions and refresh must be verified.
      </li>
      <li>
        <strong>Marketplace and Videos:</strong> their pages explain the agreed direction, findings
        and outstanding integration decisions.
      </li>
      <li>
        <strong>Additional routes:</strong> schedules, legacy account workflows and content outside
        the imported set still show explicit review notices. Native rendering counts do not certify
        full production parity.
      </li>
      <li>
        <strong>Launch audit:</strong> complete SEO, Open Graph, redirects, accessibility,
        analytics/consent, editorial workflow and operational checks. This site remains protected
        and noindex.
      </li>
    </ul>
    <p>
      <a href="/marketplace/">Marketplace status</a> · <a href="/videos/">Video library status</a> ·{' '}
      <a href="https://beta.openstack.org/">SvelteKit comparison ↗</a>
    </p>
  </main>
  )}
</Layout>
<style>
  .status {
    max-width: 1120px;
    margin: 48px auto;
    padding: 0 24px 64px;
    line-height: 1.7;
    color: #294d68;
  }
  h1 {
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.2;
  }
  h2 {
    margin-top: 40px;
  }
  .eyebrow {
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.1em;
    font-weight: bold;
  }
  .tour {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .tour > a {
    padding: 20px 24px;
    border: 1px solid #d6e1e8;
    border-radius: 6px;
    text-decoration: none;
    background: #f6f9fb;
  }
  .tour > a:hover,
  .tour > a:focus-visible {
    border-color: #ed1944;
  }
  h3 {
    margin: 0;
  }
  .tour p {
    color: #486375;
    margin: 8px 0;
  }
  .tour span {
    color: #006b94;
  }
  li {
    margin: 14px 0;
  }
  @media (max-width: 650px) {
    .tour {
      grid-template-columns: 1fr;
    }
  }
</style>
