---
import Layout from '../layouts/Site.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import Homepage from '../components/tina/Homepage.astro';
import { loadHomepage } from '../lib/tina/site';
const result = await loadHomepage();
---

<Layout
  title={result.data.homepage.seoTitle}
  description={result.data.homepage.hero.text}
  showAnnouncement={false}
>
  <TinaIsland name="homepage" wrapper={{ tag: 'div' }} primary>
    <Homepage data={result.data} />
  </TinaIsland>
</Layout>
