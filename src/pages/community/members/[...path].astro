---
import Layout from '../../../layouts/Site.astro';
Astro.response.status = 404;
---

<Layout title="Page not found | OpenStack">
  <main id="main" class="not-found">
    <h1>Page not found</h1>
    <p>We couldn’t find the page you requested.</p>
    <a href="/community/">Explore the OpenStack community →</a>
  </main>
</Layout>
<style>
  .not-found {
    max-width: 72rem;
    margin: auto;
    padding: 4rem 1.5rem;
    line-height: 1.7;
  }
  h1 {
    margin-bottom: 1rem;
  }
  p {
    margin-bottom: 1.5rem;
  }
</style>
