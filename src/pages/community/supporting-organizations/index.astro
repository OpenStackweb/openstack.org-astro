import raw from '../../../lib/content/supporting-organizations.json';
import { prepareSupportingOrganizations } from '../../../lib/server/supporting-organizations.mjs';
const content = prepareSupportingOrganizations(raw);
---

<Site
  title={content.pageTitle || content.title}
  description={content.description || content.intro || ''}
  showAnnouncement={false}
>
  <View content={content} />
</Site>
