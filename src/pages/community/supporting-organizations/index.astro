---
import Site from '../../../layouts/Site.astro';
import View from '../../../components/SupportingOrganizations.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { loadSupportingOrganizations } from '../../../lib/tina/community';
import { contentDescription } from '../../../lib/server/content-description.mjs';
const result = await loadSupportingOrganizations();
const content = result.data.supportingOrganizations;
---

<Site
  title={content.pageTitle || content.title}
  description={contentDescription(
    content.description || content.introduction,
    '/community/supporting-organizations/',
  )}
  showAnnouncement={false}
>
  <TinaIsland name="supporting-organizations" wrapper={{ tag: 'div' }} primary>
    <View content={content} />
  </TinaIsland>
</Site>
