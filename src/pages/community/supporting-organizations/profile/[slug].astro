---
import Site from '../../../../layouts/Site.astro';
import CompanyProfile from '../../../../components/CompanyProfile.astro';
import labels from '../../../../lib/content/company-profile.json';
import { loadCompanyProfile } from '../../../../lib/server/company-profiles.mjs';
import { env } from 'cloudflare:workers';
const company = await loadCompanyProfile(Astro.params.slug, labels, env);
Astro.response.headers.set('Cache-Control', 'no-store');
if (!company) Astro.response.status = 404;
---

<Site
  description={company?.description}
  title={
    company ? `${company.name} · ${labels.pageTitle} · OpenStack` : 'Company not found | OpenStack'
  }
>
  {company ? (
    <CompanyProfile company={company} labels={labels} />
  ) : (
    <main id="main">
      <h1>Company not found</h1>
      <a href="/community/supporting-organizations/">Supporting organizations</a>
    </main>
  )}
</Site>
