---
import Site from '../../layouts/Site.astro';
import View from '../../components/Community.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { loadCommunity } from '../../lib/tina/community';
const result = await loadCommunity();
const content = result.data.community;
---

<Site
  title={content.pageTitle || content.title}
  description={content.description || content.intro || ''}
  showAnnouncement={false}
>
  <TinaIsland name="community" wrapper={{ tag: 'div' }} primary>
    <View content={content} />
  </TinaIsland>
</Site>
