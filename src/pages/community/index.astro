---
import Site from '../../layouts/Site.astro';
import View from '../../components/Community.astro';
import raw from '../../lib/content/community.json';
import { prepareCommunity } from '../../lib/server/community.mjs';
const content = prepareCommunity(raw);
---

<Site
  title={content.pageTitle || content.title}
  description={content.description || content.intro || ''}
  showAnnouncement={false}
>
  <View content={content} />
</Site>
