---
import Layout from '../../layouts/Site.astro';
---

<Layout
  title="Survey staff workspace | OpenStack"
  description="Staff review of the OpenStack User Survey questionnaire drafts."
>
  <main id="main" class="staff-page">
    <h1>Survey staff workspace</h1>
    <p>
      Manage questionnaires and review responses. Each questionnaire shows its own collection
      status.
    </p>
    <div id="openstack-survey-staff" class="survey-workspace">
      <p role="status">Loading questionnaire review…</p>
    </div>
    <noscript>
      <p>Enable JavaScript to use the questionnaire review workspace.</p>
    </noscript>
  </main>
</Layout>
<script>
  import { mountSurveyWorkspace } from '../../lib/survey/mount-workspace';
  const root = document.getElementById('openstack-survey-staff');
  if (/^#\/participant(?:\/|$)/.test(location.hash)) {
    location.replace('/user-survey/' + location.hash);
  } else if (root) {
    await mountSurveyWorkspace(root, 'staff');
  }
</script>
<style>
  .staff-page {
    width: min(1440px, calc(100% - 40px));
    margin: 0 auto;
    padding: 2rem 0 3rem;
  }
</style>
