    gap: 50px;
    border-top: 4px solid var(--red);
  }
  .ai-story h4 {
    font-size: 18px;
    margin: 0 0 24px;
  }
  .ai-story strong {
    font-size: 28px;
    color: var(--red);
  }
  blockquote {
    margin: 35px 0 20px;
    padding: 0;
    border: 0;
    color: var(--ink);
    font-size: 29px;
    line-height: 1.4;
    font-weight: 300;
  }
  .advocacy {
    border-top: 1px solid #d5e0e6;
    margin-top: 45px;
    padding-top: 35px;
    display: flex;
    gap: 50px;
    align-items: center;
  }
  .advocacy > div {
    min-width: 220px;
  }
  .advocacy strong {
    font-size: 58px;
