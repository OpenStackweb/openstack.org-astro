    color: var(--ink);
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
  }
  .chapter {
    padding-top: 86px;
    padding-bottom: 86px;
    scroll-margin-top: 20px;
  }
  .chapter-intro {
    max-width: 750px;
    margin-bottom: 36px;
  }
  .survey-story h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 300;
    line-height: 1.16;
    letter-spacing: -1.2px;
    color: var(--ink);
    margin: 0 0 24px;
  }
  .survey-story h3 {
    font-size: 23px;
    line-height: 1.3;
    color: var(--ink);
    margin: 0 0 16px;
