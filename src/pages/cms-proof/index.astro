---
import Layout from '../../layouts/Site.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import HomeProof from '../../components/tina/HomeProof.astro';
import { loadProof } from '../../lib/tina/proof';
const result = await loadProof();
---
<Layout title="Tina CMS proof — OpenStack" description="A review copy of homepage content for testing Git editing and R2 media.">
  <main id="main">
    <aside class="proof-note"><strong>Editor proof of concept.</strong> This is a separate copy of homepage content. <a href="/admin/index.html#/~/cms-proof/">Open in Tina →</a></aside>
    <TinaIsland name="home-proof" wrapper={{ tag: 'div' }} primary>
      <HomeProof content={result.data.proof} />
    </TinaIsland>
  </main>
</Layout>
<style>.proof-note { padding: 1rem; background: #eef5f8; text-align: center; } .proof-note a { margin-left: 1rem; }</style>
