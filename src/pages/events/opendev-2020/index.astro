---
import Layout from '../../../layouts/Site.astro';
import archive from '../../../lib/content/archives/opendev-2020.json';
import { renderEditorialBody } from '../../../lib/server/editorial.mjs';
const body = (value: string) =>
  renderEditorialBody(
    value.replace(
      /<(\/?)(h[345])\b/g,
      (_, closing, heading) => `<${closing}${heading === 'h5' ? 'h3' : 'h2'}`,
    ),
    '/events/opendev-2020/',
  );
---

<Layout
  title="OpenDev - Discuss challenges, collaborate, create open source."
  description={archive.description}
>
  <main class="opendev">
    <header class="hero" style={{ backgroundImage: `url('${archive.hero}')` }}>
      <div class="wrap">
        <img class="logo" src={archive.logo} alt="OpenDev 2020" width="443" height="115" />
        <p class="tagline">{archive.tagline}</p>
        <h1>{archive.headline}</h1>
      </div>
    </header>
    <p class="archive-note wrap">{archive.archiveNotice}</p>
    <section class="events wrap" aria-label="The three 2020 events">
      {archive.events.map((event) => (
        <article class="event">
          <img src={event.image} alt="" width="960" height="540" />
          <div class="event-copy">
            <h2>{event.title}</h2>
            <p>{event.date}</p>
            {event.links.map((link) => (
              <a href={link.url}>
                {link.label} <span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>
    <section class="expect" aria-labelledby="expect-title">
      <div class="wrap">
        <h2 id="expect-title">What to Expect</h2>
        {archive.sections.map((section) => (
          <div class="split">
            <div class="copy" set:html={body(section.body)} />
            <figure>
              <img src={section.image} alt={section.imageAlt} loading="lazy" />
              {section.video && (
                <figcaption>
                  <a href={section.video}>Watch the OpenDev introduction ↗</a>
                </figcaption>
              )}
            </figure>
          </div>
        ))}
        <div class="copy outcomes" set:html={body(archive.outcomes)} />
      </div>
    </section>
    <section class="split wrap attendees">
      <div class="copy" set:html={body(archive.attendees.body)} />
      <img
        src={archive.attendees.image}
        alt="Participants at previous OpenDev events"
        loading="lazy"
      />
    </section>
    <section class="committee-section" aria-labelledby="committee-title">
      <div class="wrap">
        <h2 id="committee-title">2020 Open Dev Programming Committee</h2>
        <ul class="committee">
          {archive.committee.map((person) => (
            <li>
              <img src={person.image} alt="" loading="lazy" width="160" height="160" />
              <h3>{person.name}</h3>
              <p>{person.organization}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="wrap sponsor-section" aria-labelledby="sponsors-title">
      <h2 id="sponsors-title">
        Thank you to the Open Infrastructure Foundation Platinum and Gold sponsors for their ongoing
        support!
      </h2>
      <ul class="sponsors">
        {archive.sponsors.map((sponsor) => (
          <li>
            <img src={sponsor.image} alt={sponsor.name} loading="lazy" />
          </li>
        ))}
      </ul>
    </section>
    <section class="split wrap inclusion">
      <div class="copy" set:html={body(archive.inclusion.body)} />
      <img
        src={archive.inclusion.image}
        alt="Open infrastructure community members"
        loading="lazy"
      />
    </section>
  </main>
</Layout>

<style>
  .opendev {
    color: #222;
    font-size: 17px;
    line-height: 1.6;
  }
  .wrap {
    max-width: 1170px;
    margin-inline: auto;
    padding-inline: 24px;
  }
  .hero {
    background-color: #080808;
    background-size: cover;
    background-position: center;
    color: white;
    padding: 55px 0 65px;
  }
  .logo {
    width: min(350px, 80%);
    height: auto;
  }
  .tagline {
    text-transform: uppercase;
    letter-spacing: 0.13em;
    margin-top: 30px;
  }
  h1 {
    max-width: 800px;
    color: inherit;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.15;
  }
  h2 {
    font-size: 28px;
    line-height: 1.25;
  }
  .archive-note {
    font-size: 14px;
    padding-block: 20px;
  }
  .events {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    padding-bottom: 65px;
  }
  .event {
    background: #eef4f7;
  }
  .event > img {
    width: 100%;
    height: auto;
    display: block;
  }
  .event-copy {
    padding: 24px;
  }
  .event h2 {
    font-size: 23px;
    margin-top: 0;
  }
  .event a {
    display: block;
    margin-top: 12px;
    font-weight: 600;
  }
  a {
    color: #005c8f;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .expect {
    background: #111;
    color: white;
    padding-block: 55px;
  }
  .expect h2,
  .expect :global(h2),
  .expect :global(h3) {
    color: white;
  }
  .expect a,
  .expect :global(a) {
    color: #77d4ff;
  }
  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 55px;
    align-items: center;
    padding-block: 35px;
  }
  .split img {
    width: 100%;
    height: auto;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 12px;
  }
  .copy :global(h2) {
    font-size: 28px;
    line-height: 1.25;
  }
  .copy :global(h3) {
    font-size: 21px;
  }
  .copy :global(a) {
    overflow-wrap: anywhere;
  }
  .outcomes {
    max-width: 850px;
    padding-top: 15px;
  }
  .attendees,
  .inclusion {
    padding-block: 65px;
  }
  .committee-section {
    background: #eef4f7;
    padding-block: 45px;
  }
  .committee,
  .sponsors {
    list-style: none;
    margin: 30px 0 0;
    padding: 0;
    display: grid;
    gap: 35px 25px;
  }
  .committee {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    text-align: center;
  }
  .committee img {
    width: 160px;
    max-width: 100%;
    height: 160px;
    object-fit: cover;
    border-radius: 50%;
  }
  .committee h3 {
    font-size: 20px;
    margin: 12px 0 0;
  }
  .committee p {
    margin: 4px 0;
    font-size: 15px;
  }
  .sponsor-section {
    padding-block: 55px;
    text-align: center;
  }
  .sponsors {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: center;
  }
  .sponsors img {
    width: 100%;
    height: 100px;
    object-fit: contain;
  }
  @media (max-width: 760px) {
    .events,
    .split {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .committee {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .sponsors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero {
      padding-block: 35px;
    }
    .split {
      padding-block: 25px;
    }
  }
</style>
