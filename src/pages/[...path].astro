---
import PaperReader from '../components/PaperReader.astro';
import { paperPageFor } from '../lib/server/paper-pages.js';
import ApplicationNotice from '../components/ApplicationNotice.astro';
import { appStatus } from '../lib/app-status.mjs';
import Layout from '../layouts/Site.astro';
import IndustryLanding from '../components/IndustryLanding.astro';
import SummitHighlights from '../components/SummitHighlights.astro';
import Editorial from '../components/Editorial.astro';
import { editorialPageFor } from '../lib/server/editorial-pages.js';
import { reviewStatusFor } from '../lib/review-status.mjs';
import { scheduleRoute } from '../lib/schedule-routes.js';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import EditorialPage from '../components/tina/EditorialPage.astro';
import { editablePageFor, loadEditorial } from '../lib/tina/editorial';
const schedule = scheduleRoute(Astro.url.pathname);
const application = Astro.url.pathname.startsWith('/marketplace')
  ? appStatus.marketplace
  : Astro.url.pathname.startsWith('/videos')
    ? appStatus.videos
    : null;
const paper = paperPageFor(Astro.url.pathname, Astro.url.searchParams.get('lang') || 'en_US');
const page = editorialPageFor(Astro.url.pathname);
const editable = page ? editablePageFor(page.path) : undefined;
const editor = editable ? await loadEditorial(editable.filename) : null;
const status = reviewStatusFor(Astro.url.pathname);
const appNotice = /^\/(marketplace|videos|auth|admin)(\/|$)/.test(Astro.url.pathname);
if (!paper && !page && !status && !appNotice && !schedule) Astro.response.status = 404;
const title =
  paper?.title ||
  application?.title ||
  page?.title ||
  (schedule ? 'Summit schedule migration' : null) ||
  status?.title ||
  (appNotice ? 'Application status' : 'Page not found');
---

<Layout
  locale={paper?.locale || 'en_US'}
  title={`${page?.seoTitle || title} | OpenStack`}
  description={paper?.description || page?.description}
  socialType={paper || page?.kind === 'release' ? 'article' : 'website'}
  socialCard={paper || page?.hero || page?.highlights ? 'summary_large_image' : 'summary'}
  canonicalUrl={
    paper
      ? `https://www.openstack.org${paper.path}${paper.locale === 'en_US' ? '' : '?lang=' + paper.locale}`
      : undefined
  }
  socialImage={
    paper?.coverImage ||
    page?.highlights?.hero?.image ||
    page?.hero?.image ||
    '/images/openstack-social.jpg'
  }
>
  {paper && (
    <Fragment slot="head">
      {paper.languages.map((language: any) => (
        <link
          rel="alternate"
          hreflang={language.locale.replace('_', '-')}
          href={`https://www.openstack.org${paper.path}?lang=${language.locale}`}
        />
      ))}
    </Fragment>
  )}
  {paper ? (
    <PaperReader paper={paper} />
  ) : application ? (
    <ApplicationNotice content={application} />
  ) : editor && editable ? (
    <TinaIsland name="editorial" params={{ document: editable.filename }} wrapper={{ tag: 'div' }} primary>
      <EditorialPage content={editor.data.editorial} sharedEvent={editor.data.archiveEvent} />
    </TinaIsland>
  ) : page ? (
    page.highlights ? (
      <SummitHighlights page={page} />
    ) : page.industry ? (
      <IndustryLanding page={page} />
    ) : (
      <Editorial page={page} />
    )
  ) : status && !schedule ? (
    <ApplicationNotice content={status} />
  ) : (
    <main id="main" class="notice">
      <h1>{title}</h1>
      <p>
        {schedule
          ? 'This summit schedule and its event and speaker details have not yet been ported to Astro. They require the Summit API integration; importing the surrounding content pages does not replace that application. This page is a migration notice, and no SilverStripe proxy is used.'
          : page || status || appNotice
          ? 'This template or application has not been ported to the Astro comparison yet. It is not being proxied or presented as a completed migration.'
          : 'This URL is not part of the Astro comparison.'}
      </p>
      <p>
        <a href={new URL(Astro.url.pathname, 'https://beta.openstack.org').href}>
          View this page in the SvelteKit beta ↗
        </a>
      </p>
      <p>
        <a href="/comparison/">Implementation status</a>
      </p>
    </main>
  )}
</Layout>
<style>
  .notice {
    max-width: 960px;
    margin: 48px auto;
    padding: 0 24px;
    line-height: 1.7;
  }
</style>
