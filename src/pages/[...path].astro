---
import PaperReader from '../components/PaperReader.astro';
import { paperPageFor } from '../lib/server/paper-pages.js';
import ApplicationNotice from '../components/ApplicationNotice.astro';
import { appStatus } from '../lib/app-status.mjs';
import Layout from '../layouts/Site.astro';
import IndustryLanding from '../components/IndustryLanding.astro';
import SummitHighlights from '../components/SummitHighlights.astro';
import Editorial from '../components/Editorial.astro';
import { editorialPageFor } from '../lib/server/editorial-pages.js';
import { prepareConference } from '../lib/server/conferences.mjs';
import conferenceKeys from '../lib/content/conference-keys.json';
import archiveEvents from '../lib/server/archive-event-content.mjs';
import { reviewStatusFor } from '../lib/review-status.mjs';
import { scheduleRoute } from '../lib/schedule-routes.js';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import EditorialPage from '../components/tina/EditorialPage.astro';
import { editablePageFor, loadEditorial } from '../lib/tina/editorial';
import { canonicalFor } from '../lib/seo.mjs';
const schedule = scheduleRoute(Astro.url.pathname);
const scheduleEvent = schedule ? editorialPageFor(`/summit/${schedule.key}/`) : null;
const scheduleTitle =
  scheduleEvent?.archiveEventTitle ||
  scheduleEvent?.title ||
  (schedule
    ? schedule.key.replace(/-/g, ' ').replace(/\b[a-z]/g, (letter) => letter.toUpperCase())
    : 'Summit');
const application = Astro.url.pathname.startsWith('/marketplace')
  ? appStatus.marketplace
  : Astro.url.pathname.replace(/\/$/, '') === '/project-mascots'
    ? appStatus.mascots
    : Astro.url.pathname.startsWith('/videos')
      ? appStatus.videos
      : null;
const paper = paperPageFor(Astro.url.pathname, Astro.url.searchParams.get('lang') || 'en_US');
const conferenceKey = conferenceKeys.find(
  (key) => Astro.url.pathname.replace(/\/$/, '') === `/summit/${key}`,
);
const page =
  editorialPageFor(Astro.url.pathname) ||
  (conferenceKey ? prepareConference(conferenceKey, archiveEvents, editorialPageFor) : null);
const editable = page ? editablePageFor(page.path) : undefined;
const editor = editable ? await loadEditorial(editable.filename) : null;
const status = reviewStatusFor(Astro.url.pathname);
const appNotice = /^\/(marketplace|videos|auth|admin)(\/|$)/.test(Astro.url.pathname);
if (!paper && !page && !status && !appNotice && !schedule) Astro.response.status = 404;
const title =
  paper?.title ||
  application?.title ||
  page?.title ||
  (schedule ? `${scheduleTitle} — schedule archive` : null) ||
  status?.title ||
  (appNotice ? 'Application status' : 'Page not found');
---

<Layout
  locale={paper?.locale || 'en_US'}
  title={`${paper?.seoTitle || page?.seoTitle || title} | OpenStack`}
  description={
    paper?.description || page?.description || application?.introduction || status?.introduction
  }
  socialType={paper || page?.kind === 'release' ? 'article' : 'website'}
  socialCard={
    paper || page?.hero || page?.highlights || page?.archivePresentation
      ? 'summary_large_image'
      : 'summary'
  }
  canonicalUrl={paper ? canonicalFor(paper.path, { locale: paper.locale }) : undefined}
  socialImageAlt={
    paper?.socialImageAlt ||
    page?.socialImageAlt ||
    (page?.archivePresentation ? page.archiveEventTitle : undefined)
  }
  socialImage={
    paper?.socialImage ||
    page?.highlights?.hero?.image ||
    page?.hero?.image ||
    page?.archivePresentation?.banner ||
    '/images/social/openstack.png'
  }
>
  {paper && (
    <Fragment slot="head">
      {paper.languages.map((language: any) => (
        <link
          rel="alternate"
          hreflang={language.locale.replace('_', '-')}
          href={canonicalFor(paper.path, { locale: language.locale })}
        />
      ))}
      <link rel="alternate" hreflang="x-default" href={canonicalFor(paper.path)} />
    </Fragment>
  )}
  {paper ? (
    <PaperReader paper={paper} />
  ) : application ? (
    <ApplicationNotice content={application} />
  ) : editor && editable ? (
    <TinaIsland
      name="editorial"
      params={{ document: editable.filename }}
      wrapper={{ tag: 'div' }}
      primary
    >
      <EditorialPage content={editor.data.editorial} sharedEvent={editor.data.archiveEvent} />
    </TinaIsland>
  ) : page ? (
    page.highlights ? (
      <SummitHighlights page={page} />
    ) : page.industry ? (
      <IndustryLanding page={page} />
    ) : (
      <Editorial page={page} />
    )
  ) : status && !schedule ? (
    <ApplicationNotice content={status} />
  ) : (
    <main id="main" class="notice">
      <h1>{title}</h1>
      {schedule ? (
        <>
          <p>
            This Summit has concluded. The interactive schedule and individual session details are
            not available on this website.
          </p>
          <p>
            Explore the event archive for information and highlights, or browse OpenStack talks on
            the OpenInfra Foundation’s YouTube channel.
          </p>
          <ul>
            <li>
              <a href={`/summit/${schedule.key}/${scheduleEvent ? '' : 'faq/'}`}>
                View archived Summit information
              </a>
            </li>
            <li>
              <a href="https://www.youtube.com/@OpenInfraFoundation">
                Browse OpenInfra talks on YouTube
              </a>
            </li>
            <li>
              <a href="/other-summits/">Explore other past Summits</a>
            </li>
          </ul>
        </>
      ) : (
        <p>
          {page || status || appNotice
            ? 'This template or application has not been ported to the Astro comparison yet. It is not being proxied or presented as a completed migration.'
            : 'The page you requested could not be found. Please check the address or use the site navigation.'}
        </p>
      )}
    </main>
  )}
</Layout>
<style>
  .notice {
    max-width: 960px;
    margin: 48px auto;
    padding: 0 24px;
    line-height: 1.7;
  }
</style>
