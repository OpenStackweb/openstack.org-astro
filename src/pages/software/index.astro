---
import Layout from '../../layouts/Site.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SoftwareOverview from '../../components/tina/SoftwareOverview.astro';
import { loadSoftwareOverview } from '../../lib/tina/site';
if (Astro.url.searchParams.has('release'))
  return Astro.redirect(
    '/software/project-navigator/openstack-components/?release=' +
      encodeURIComponent(Astro.url.searchParams.get('release') || ''),
    307,
  );
const result = await loadSoftwareOverview();
---

<Layout
  title={result.data.softwareOverview.pageTitle}
  description={result.data.softwareOverview.description}
>
  <TinaIsland name="software-overview" wrapper={{ tag: 'div' }} primary>
    <SoftwareOverview content={result.data.softwareOverview} />
  </TinaIsland>
</Layout>
