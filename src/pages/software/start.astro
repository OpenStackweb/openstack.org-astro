---
import Layout from '../../layouts/Site.astro';
import SoftwareNavigation from '../../components/SoftwareNavigation.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import SoftwareStart from '../../components/tina/SoftwareStart.astro';
import { loadSoftwareStart } from '../../lib/tina/software-start';
const result = await loadSoftwareStart();
const content = result.data.softwareStart;
---
<Layout title={content.pageTitle} description={content.description || ''}>
  <SoftwareNavigation />
  <TinaIsland name="software-start" wrapper={{ tag: 'div' }} primary>
    <SoftwareStart content={content} />
  </TinaIsland>
</Layout>
