---
import { env } from 'cloudflare:workers';
import { marketplaceMetadata } from '../../lib/server/marketplace-metadata.mjs';
import MarketplaceHome from '../../components/tina/MarketplaceHome.astro';
import { loadMarketplaceHome } from '../../lib/tina/marketplace-home';
import { loadMarketplaceShared } from '../../lib/tina/marketplace-shared';
import MarketplaceShared from '../../components/tina/MarketplaceShared.astro';
import Layout from '../../layouts/Site.astro';
import ApplicationNotice from '../../components/ApplicationNotice.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import MarketplaceApp from '../../lib/marketplace/MarketplaceApp.jsx';
import TrainingApp from '../../lib/marketplace/TrainingApp.jsx';
import MarketplaceCategory from '../../components/tina/MarketplaceCategory.astro';
import { loadMarketplacePage } from '../../lib/tina/marketplace';
import ProviderMap from '../../lib/marketplace/ProviderMap.jsx';
import { loadMarketplaceDetails } from '../../lib/tina/marketplace-details';
import ProviderDetails from '../../components/marketplace/ProviderDetails.astro';
import { loadMarketplaceCatalogue } from '../../lib/server/marketplace-catalogue.mjs';
import { reviewStatusFor } from '../../lib/review-status.mjs';
import '../../lib/marketplace/marketplace.css';
const segments = (Astro.params.path || '').split('/').filter(Boolean);
// Preserve the reviewed legacy C-DAC URL after trimming its source slug.
const legacyTrainingPath =
  '/marketplace/training/centre-for-development-of-advanced-computing%20/c-dac-training-for-openstack/';
if (Astro.url.pathname === legacyTrainingPath) {
  return Astro.redirect(legacyTrainingPath.replace('%20/', '/'), 301);
}
let catalogue;
try {
  catalogue = await loadMarketplaceCatalogue(env, segments[0]);
} catch {
  console.error('Marketplace catalogue read failed');
  return new Response('Marketplace is temporarily unavailable. Please try again shortly.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' },
  });
}
Astro.response.headers.set('Cache-Control', 'private, no-store');
const category = catalogue.categories.find((c) => c.slug === segments[0]);
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') + '/';
const record =
  category && segments.length > 1
    ? category.records.find((r) => r.href === canonicalPath)
    : undefined;
const unknown = segments.length > 0 && (!category || (segments.length > 1 && !record));
const historicalNotice = unknown ? reviewStatusFor(Astro.url.pathname) : null;
if (unknown && !historicalNotice) Astro.response.status = 404;
const title = unknown
  ? historicalNotice?.title || 'Marketplace listing not found'
  : record?.name || category?.title || 'OpenStack Marketplace';
const editorial =
  category && !record && !unknown
    ? (await loadMarketplacePage(category.slug)).data.marketplacePage
    : null;
const home = !segments.length ? (await loadMarketplaceHome()).data.marketplaceHome : null;
const detailContent = record ? (await loadMarketplaceDetails()).data.marketplaceDetails : null;
const providerMetadata = record && category ? marketplaceMetadata(record, category) : null;
const apiKey = (env as unknown as Record<string, string>).GATSBY_GOOGLE_MAP_KEY || '';
const shared = (await loadMarketplaceShared()).data.marketplaceShared;
const categoryPages = await Promise.all(
  catalogue.categories.map(async (category) => ({
    ...category,
    editorial: (await loadMarketplacePage(category.slug)).data.marketplacePage,
  })),
);
const categoryOrder = (shared.categoryOrder || []).map((row: { slug: string }) => row.slug);
categoryPages.sort(
  (a, b) =>
    (categoryOrder.includes(a.slug) ? categoryOrder.indexOf(a.slug) : 999) -
    (categoryOrder.includes(b.slug) ? categoryOrder.indexOf(b.slug) : 999),
);
---

<Layout
  title={
    editorial?.pageTitle ||
    home?.pageTitle ||
    providerMetadata?.title ||
    `${title} | OpenStack Marketplace`
  }
  description={
    editorial?.description ||
    home?.description ||
    providerMetadata?.description ||
    historicalNotice?.introduction ||
    'Explore OpenStack providers, services and training. Read-only Marketplace integration preview.'
  }
>
  {historicalNotice ? (
    <ApplicationNotice content={historicalNotice} />
  ) : (
    <main id="main" class="marketplace-shell">
      <div class="marketplace-sidebar">
        <nav class="marketplace-nav" aria-label="Marketplace categories">
          <a class="marketplace-home-link" href="/marketplace/">
            The OpenStack Marketplace
          </a>
          {categoryPages.map((c) => (
            <a
              href={`/marketplace/${c.slug}/`}
              aria-current={category?.slug === c.slug ? 'page' : undefined}
            >
              <TinaIsland
                name="marketplace"
                params={{ document: c.slug, section: 'icon' }}
                wrapper={{ tag: 'div' }}
              >
                <MarketplaceCategory content={c.editorial} section="icon" />
              </TinaIsland>
              {c.title}
            </a>
          ))}
        </nav>
        <TinaIsland name="marketplace-shared" wrapper={{ tag: 'div' }}>
          <MarketplaceShared content={shared} />
        </TinaIsland>
      </div>
      <div class="marketplace-content">
        <TinaIsland name="marketplace-shared" params={{ section: 'join' }} wrapper={{ tag: 'div' }}>
          <MarketplaceShared content={shared} section="join" />
        </TinaIsland>
        <aside class="marketplace-notice">
          Marketplace catalogue · Updated {catalogue.fetchedAt.slice(0, 10)}.
        </aside>
        {!editorial && !home && <h1>{title}</h1>}
        {unknown ? (
          <p>
            This listing is not in the current catalogue.{' '}
            <a href="/marketplace/">Browse Marketplace categories</a>.
          </p>
        ) : record ? (
          <>
            <a href={`/marketplace/${category!.slug}/`}>← All {category!.title}</a>
            <div class="marketplace-detail">
              <TinaIsland
                name="marketplace-details"
                params={{ record: record.href, section: 'overview' }}
                wrapper={{ tag: 'div' }}
                primary
              >
                <ProviderDetails
                  fetchedAt={catalogue.fetchedAt}
                  record={record}
                  content={detailContent}
                  section="overview"
                />
              </TinaIsland>
              {record.locations.length > 0 && (
                <ProviderMap records={[record]} apiKey={apiKey} detail client:load />
              )}
              <TinaIsland
                name="marketplace-details"
                params={{ record: record.href, section: 'details' }}
                wrapper={{ tag: 'div' }}
              >
                <ProviderDetails
                  fetchedAt={catalogue.fetchedAt}
                  record={record}
                  content={detailContent}
                  section="details"
                />
              </TinaIsland>
            </div>
          </>
        ) : category ? (
          <>
            <TinaIsland
              name="marketplace"
              params={{ document: category.slug }}
              wrapper={{ tag: 'div' }}
              primary
            >
              <MarketplaceCategory content={editorial} />
            </TinaIsland>
            {category.slug === 'training' ? (
              <TrainingApp records={category.records} fetchedAt={catalogue.fetchedAt} client:load />
            ) : (
              <MarketplaceApp category={category} apiKey={apiKey} client:load />
            )}
            <TinaIsland
              name="marketplace"
              params={{ document: category.slug, section: 'footer' }}
              wrapper={{ tag: 'div' }}
            >
              <MarketplaceCategory content={editorial} section="footer" />
            </TinaIsland>
          </>
        ) : (
          <TinaIsland name="marketplace-home" wrapper={{ tag: 'div' }} primary>
            <MarketplaceHome content={home} />
          </TinaIsland>
        )}
      </div>
    </main>
  )}
</Layout>
