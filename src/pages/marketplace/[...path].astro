---
import { env } from 'cloudflare:workers';
import MarketplaceHome from '../../components/tina/MarketplaceHome.astro';
import { loadMarketplaceHome } from '../../lib/tina/marketplace-home';
import Layout from '../../layouts/Site.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import MarketplaceApp from '../../lib/marketplace/MarketplaceApp.jsx';
import TrainingApp from '../../lib/marketplace/TrainingApp.jsx';
import MarketplaceCategory from '../../components/tina/MarketplaceCategory.astro';
import { loadMarketplacePage } from '../../lib/tina/marketplace';
import ProviderMap from '../../lib/marketplace/ProviderMap.jsx';
import { loadMarketplaceDetails } from '../../lib/tina/marketplace-details';
import ProviderDetails from '../../components/marketplace/ProviderDetails.astro';
import catalogue from '../../lib/marketplace/catalog.json';
import { reviewStatusFor } from '../../lib/review-status.mjs';
import '../../lib/marketplace/marketplace.css';
const segments = (Astro.params.path || '').split('/').filter(Boolean);
const category = catalogue.categories.find((c) => c.slug === segments[0]);
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') + '/';
const record =
  category && segments.length > 1
    ? category.records.find((r) => r.href === canonicalPath)
    : undefined;
const unknown = segments.length > 0 && (!category || (segments.length > 1 && !record));
const historicalNotice = unknown && reviewStatusFor(Astro.url.pathname);
if (unknown && !historicalNotice) Astro.response.status = 404;
const title = unknown
  ? 'Marketplace listing not found'
  : record?.name || category?.title || 'OpenStack Marketplace';
const editorial =
  category && !record && !unknown
    ? (await loadMarketplacePage(category.slug)).data.marketplacePage
    : null;
const home = !segments.length ? (await loadMarketplaceHome()).data.marketplaceHome : null;
const detailContent = record ? (await loadMarketplaceDetails()).data.marketplaceDetails : null;
const apiKey = (env as unknown as Record<string, string>).GATSBY_GOOGLE_MAP_KEY || '';
---

<Layout
  title={editorial?.pageTitle || home?.pageTitle || `${title} | OpenStack Marketplace`}
  description={
    editorial?.description ||
    home?.description ||
    'Explore OpenStack providers, services and training. Read-only Marketplace integration preview.'
  }
>
  <main id="main" class="marketplace-shell">
    <nav class="marketplace-nav" aria-label="Marketplace categories">
      <a href="/marketplace/">Marketplace</a>
      {catalogue.categories.map((c) => (
        <a
          href={`/marketplace/${c.slug}/`}
          aria-current={category?.slug === c.slug ? 'page' : undefined}
        >
          {c.title}
        </a>
      ))}
    </nav>
    <aside class="marketplace-notice">
      Marketplace integration preview · Public catalogue from oifapi.openinfra.dev. Review
      submission, administration and production readiness are not yet verified. Data snapshot:{' '}
      {catalogue.fetchedAt.slice(0, 10)}.
    </aside>
    {!editorial && !home && <h1>{title}</h1>}
    {unknown ? (
      <p>
        {historicalNotice
          ? 'This historical Marketplace destination has not yet been matched to the replacement catalogue.'
          : 'This listing is not in the current catalogue.'}{' '}
        <a href="/marketplace/">Browse Marketplace categories</a>.
      </p>
    ) : record ? (
      <>
        <a href={`/marketplace/${category!.slug}/`}>← All {category!.title}</a>
        <div class="marketplace-detail">
          <TinaIsland
            name="marketplace-details"
            params={{ record: record.href, section: 'overview' }}
            wrapper={{ tag: 'div' }}
            primary
          >
            <ProviderDetails record={record} content={detailContent} section="overview" />
          </TinaIsland>
          {record.locations.length > 0 && (
            <ProviderMap records={[record]} apiKey={apiKey} detail client:load />
          )}
          <TinaIsland
            name="marketplace-details"
            params={{ record: record.href, section: 'details' }}
            wrapper={{ tag: 'div' }}
          >
            <ProviderDetails record={record} content={detailContent} section="details" />
          </TinaIsland>
        </div>
      </>
    ) : category ? (
      <>
        <TinaIsland
          name="marketplace"
          params={{ document: category.slug }}
          wrapper={{ tag: 'div' }}
          primary
        >
          <MarketplaceCategory content={editorial} />
        </TinaIsland>
        {category.slug === 'training' ? (
          <TrainingApp records={category.records} client:load />
        ) : (
          <MarketplaceApp category={category} apiKey={apiKey} client:load />
        )}
        <TinaIsland
          name="marketplace"
          params={{ document: category.slug, section: 'footer' }}
          wrapper={{ tag: 'div' }}
        >
          <MarketplaceCategory content={editorial} section="footer" />
        </TinaIsland>
      </>
    ) : (
      <TinaIsland name="marketplace-home" wrapper={{ tag: 'div' }} primary>
        <MarketplaceHome content={home} />
      </TinaIsland>
    )}
  </main>
</Layout>
