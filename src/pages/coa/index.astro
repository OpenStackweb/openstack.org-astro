---
import Site from '../../layouts/Site.astro';
import View from '../../components/Coa.astro';
import raw from '../../lib/content/coa.json';
import { prepareCoa } from '../../lib/server/coa.mjs';
import { contentDescription } from '../../lib/server/content-description.mjs';
const content = prepareCoa(raw);
---

<Site
  title={content.pageTitle || content.title}
  description={contentDescription(content.description || content.hero.description, '/coa/')}
  showAnnouncement={false}
>
  <View content={content} />
</Site>
