{
  "name": "openstack.org-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "software:check": "node scripts/check-software-api.mjs",
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write \"src/**/*.astro\" src/middleware.ts astro.config.mjs",
    "cms:dev": "tinacms dev -c \"astro dev --host 127.0.0.1 --port 4390\"",
    "cms:build": "tinacms build",
    "postinstall": "node scripts/patch-react-final-form.mjs && node scripts/patch-tina-list-keyboard.mjs && node scripts/patch-tina-field-labels.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/react": "6.0.5",
    "@tinacms/astro": "0.7.0",
    "@tinacms/auth": "1.1.5",
    "astro": "7.3.2",
    "entities": "8.1.0",
    "leaflet": "^1.9.4",
    "marked": "18.0.12",
    "oidc-client-ts": "3.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.17.7",
    "tinacms": "3.13.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "5.20260911.1",
    "@tinacms/cli": "2.7.0",
    "@types/react": "18",
    "@types/react-dom": "18",
    "parse-srcset": "1.0.2",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "6.0.3",
    "wrangler": "4.129.1"
  }
}
