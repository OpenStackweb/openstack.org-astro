{
  "name": "openstack.org-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "software:check": "node scripts/check-software-api.mjs",
    "dev": "astro dev",
    "build": "node scripts/build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write \"{src,tina,scripts}/**/*.{astro,js,jsx,mjs,ts,tsx,css}\" \"*.{mjs,ts,json}\" \".github/workflows/*.yml\"",
    "cms:dev": "tinacms dev -c \"astro dev --host 127.0.0.1 --port 4390\"",
    "cms:build": "tinacms build",
    "postinstall": "node scripts/patch-tina-list-keyboard.mjs && node scripts/patch-tina-field-labels.mjs",
    "marketplace:refresh": "node scripts/import-marketplace.mjs",
    "cms:schema": "tinacms dev --no-server --noWatch",
    "format:check": "prettier --check \"{src,tina,scripts}/**/*.{astro,js,jsx,mjs,ts,tsx,css}\" \"*.{mjs,ts,json}\" \".github/workflows/*.yml\"",
    "security:audit": "npm audit --audit-level=critical"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.1",
    "@astrojs/react": "6.0.5",
    "@tinacms/astro": "0.7.0",
    "@tinacms/auth": "1.1.5",
    "@vis.gl/react-google-maps": "1.7.1",
    "astro": "7.4.2",
    "entities": "8.1.0",
    "leaflet": "1.9.4",
    "marked": "18.0.12",
    "oidc-client-ts": "3.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sanitize-html": "2.18.1",
    "tinacms": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/workers-types": "5.20261024.1",
    "@tinacms/cli": "4.0.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "parse-srcset": "1.0.2",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "undici@7.29.1": "7.30.1"
  }
}
